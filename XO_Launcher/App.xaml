<Application
    x:Class="XO_Launcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D1117" />
                    <SolidColorBrush x:Key="AppBarBackgroundBrush" Color="#161B22" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1C2333" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A3348" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#3FB950" />
                    <SolidColorBrush x:Key="AccentDarkBrush" Color="#2EA043" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#21262D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
