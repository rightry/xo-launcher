<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.AppDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 自绘弹窗：全应用**不再使用** WinUI 自带的 ContentDialog。
         ContentDialog 在 WinUI 3 里的模板会去读一大堆 ContentDialog* 资源键，
         而这些键在 App.xaml 的主题字典里改不动（模板解析时机早于我们的覆盖），
         结果就是：叠色去不掉、分隔线去不掉、四角留白、按钮是系统描边样式。
         与其继续和别人的模板搏斗，不如自己画一层。
         结构：整窗遮罩（点击可关） → 居中卡片（圆角 + 卡片底色 + 阴影）。 -->
    <Grid x:Name="RootLayer" Background="{ThemeResource DialogScrimBrush}" Visibility="Collapsed">

        <!-- 点遮罩关闭：只在真的点到遮罩本身时生效（卡片上不会冒泡到这） -->
        <Grid x:Name="ScrimHit" Background="Transparent" Tapped="Scrim_Tapped" />

        <!-- 弹窗卡片同样走 WinUI 原生亚克力：它浮在页面内容之上，backdrop 模糊到的正是
             身后的整页内容 + 全景，不需要再单独挂一层弹窗磨砂。 -->
        <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="320" MaxWidth="560" Margin="32"
                Background="{ThemeResource CardAcrylicBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1"
                CornerRadius="12" Padding="22,20,22,18">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Spacing="14">
                <StackPanel x:Name="HeaderPanel" Spacing="6">
                    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleStyle}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource BodyTextStyle}"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>

                <!-- 自定义内容挂载点（列表、输入框等） -->
                <ContentPresenter x:Name="BodyHost" Visibility="Collapsed" />

                <!-- 按钮区：右对齐、间距 10。顺序与 ContentDialog 一致：
                     次要（取消类）在左、主要（确认类）在最右。 -->
                <StackPanel x:Name="ButtonRow" Orientation="Horizontal"
                            HorizontalAlignment="Right" Spacing="10" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
