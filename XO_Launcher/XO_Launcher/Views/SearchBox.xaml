<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.SearchBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 自制搜索框：外壳、图标、清除键、搜索键全部由本控件自己画，
         只把最里层的 TextBox 用作「接收键盘输入」的裸元件（透明、无边框、无聚焦视觉），
         交互态（悬停 / 聚焦描边）也由代码后置接管 —— 不再依赖 WinUI 搜索框的默认外观。 -->
    <UserControl.Resources>
        <Style x:Key="SearchIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="Shell" Height="46" CornerRadius="10"
            Background="{ThemeResource TextControlBackground}"
            BorderBrush="{ThemeResource TextControlBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF699;" FontSize="14"
                      Margin="14,0,2,0" Foreground="{ThemeResource TextSecondaryBrush}"
                      VerticalAlignment="Center" />

            <TextBox x:Name="Input" Grid.Column="1" Style="{StaticResource AppInlineTextBoxStyle}"
                     PlaceholderText="搜索…" />

            <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource SearchIconButtonStyle}"
                    Visibility="Collapsed" ToolTipService.ToolTip="清除">
                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF369;" FontSize="11" />
            </Button>

            <Button x:Name="QueryButton" Grid.Column="3" Height="34" MinWidth="78" Padding="16,0" Margin="4,0,7,0"
                    Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentOnBrush}"
                    BorderThickness="0" CornerRadius="8" FontSize="13" FontWeight="SemiBold"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF699;" FontSize="13" />
                    <TextBlock x:Name="QueryLabel" Text="搜索" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
