<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.SelectBox"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    FontFamily="{ThemeResource AppFontFamily}"
    FontSize="13"
    Foreground="{ThemeResource TextPrimaryBrush}"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    MinHeight="40"
    VerticalAlignment="Center">

    <!-- 自制下拉列表：外壳、下拉面板、列表项、勾选态全部由本控件自绘，
         不再依赖 WinUI ComboBox 的模板与它那一整套 ComboBox* 主题键。
         弹出层用 Popup + PlacementTarget（DesiredPlacement=Bottom），
         位置与「下方放不下就往上翻」交给系统算（ActualPlacement 可查），
         点面板外关闭用 IsLightDismissEnabled。
         外壳底色/描边复用输入控件那组 TextControl* 键，和 TextInput / SearchBox 同源。 -->
    <Grid>
        <Border x:Name="Shell"
                Background="{ThemeResource TextControlBackground}"
                BorderBrush="{ThemeResource TextControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="11,10,6,10"
                MinHeight="40"
                HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 选中项：内容按 ItemTemplate / DisplayMemberPath 生成，代码里塞进 SelectionHost -->
                <ContentPresenter x:Name="SelectionHost" Grid.Column="0"
                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Visibility="Collapsed" />
                <TextBlock x:Name="PlaceholderLabel" Grid.Column="0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextControlPlaceholderForeground}" />

                <FontIcon x:Name="Chevron" Grid.Column="1"
                          FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF2A3;"
                          FontSize="12" Margin="6,0,4,0" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <Popup x:Name="DropPopup"
               IsLightDismissEnabled="True"
               ShouldConstrainToRootBounds="True"
               DesiredPlacement="Bottom">
            <Border x:Name="PanelRoot"
                    Background="{ThemeResource DropDownBackgroundBrush}"
                    BorderBrush="{ThemeResource DropDownBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    MaxHeight="360">
                <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled">
                    <!-- 行只在第一次展开时才生成（见 EnsureRows）：设置页的「界面字体」
                         是整台机器的字体清单，两百多行如果在进页面时就全建出来会占死 UI 线程。 -->
                    <StackPanel x:Name="OptionHost" />
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
