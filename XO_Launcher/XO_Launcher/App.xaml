<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="XO_Launcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ★ BasedOn 的「可见性垫片」。这个属性元素必须唯一且出现在**所有键之前**，
                 原因有两层：

                 一（XAML 语法）：ResourceDictionary 的 MergedDictionaries 是属性元素，
                     一个对象只能赋一次值 —— 拆成两块会得到
                     WMC0035「Duplication assignment to the 'MergedDictionaries' property」；
                     而它又必须先于所有普通键，否则后面的键会被算进隐式 _Items，再报一次
                     WMC0035「Duplication assignment to the '_Items' property」。
                     所以正确形态只有一种：属性元素统一在顶部，普通键全部排在它后面。

                 二（资源查找）：App.xaml 根字典本层声明的样式，解析期取
                     BasedOn="{StaticResource DefaultXxxStyle}" 时只会查
                     「自己 + 自己 MergedDictionaries 的项」，**不会**去翻根字典顶部的
                     那份 XamlControlsResources（那是兄弟节点，不是祖先）。
                     把 XamlControlsResources 声明进本字典自己的 MergedDictionaries，
                     DefaultExpanderStyle / DefaultTextBoxStyle … 才成为本字典可见的合并项。

                 没有这一块：AppCompactExpanderStyle 解析失败 → SkinsPage 构造即抛
                 XamlParseException「Cannot find a Resource with the Name/Key
                 DefaultExpanderStyle」，整页打不开，而编译期完全看不出问题。
                 （同类前科：DefaultListViewStyle 在 2026-09-03 踩过一模一样的坑。）

                 不要试图删掉它去「验一下是否真的需要」—— 删掉即刻复现上述崩溃。 -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                结构色（背景 / 文字 / 分割线）按亮暗主题固定。
                强调色（Accent*、开关、超链接等）只放占位，启动后由 ThemeService.ApplyAccent
                按用户选择的主题色改写 Color，已解析的 SolidColorBrush 会就地更新。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E0E0E" />
                    <SolidColorBrush x:Key="BarBackgroundBrush" Color="#0E0E0E" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2D2D2D" />
                    <!-- 无卡片分栏用的「凹陷地面」：比页面底色更沉一档，用来承载输入区/房间码这类内容 -->
                    <SolidColorBrush x:Key="RecessedBackgroundBrush" Color="#59000000" />
                    <SolidColorBrush x:Key="RecessedBorderBrush" Color="#262626" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E9E9E" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#151515" />
                    <!-- 卡片底色：WinUI 原生亚克力（in-app backdrop）。
                         XAML 里声明成实心（1 / 1），因为没开全景时卡片本来就该是实心；
                         开全景后由 ThemeService.RefreshCardFrostTint 把 TintOpacity 与
                         TintLuminosityOpacity 一起降下来，卡片才真正透出并糊出身后的全景。
                         两个都要降：只降 TintOpacity 会被亮度浓度顶回去，看着还是实心。 -->
                    <AcrylicBrush x:Key="CardAcrylicBrush" TintColor="#151515" TintOpacity="1"
                                  TintLuminosityOpacity="1" FallbackColor="#1F1F1F" />
                    <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="#101010" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#141414" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0E0E0E" />
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="NeutralButtonBrush" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="NeutralButtonForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="GhostButtonForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="GhostButtonForegroundHover" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="ChromeTextBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="DangerButtonBrush" Color="#3A2222" />
                    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="#E8B4B4" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B2A1B" />
                    <SolidColorBrush x:Key="AccentSoftForegroundBrush" Color="#7CBD4B" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#808080" />

                    <!-- 自绘弹窗的遮罩。比系统 ContentDialogSmokeFill 略深一点：
                         自绘弹窗没有系统那层额外的投影扩散，遮罩要自己扛住「把背景压下去」的职责。 -->
                    <SolidColorBrush x:Key="DialogScrimBrush" Color="#A8000000" />

                    <SolidColorBrush x:Key="AccentBrush" Color="#7CBD4B" />
                    <SolidColorBrush x:Key="AccentDarkBrush" Color="#5B8731" />
                    <SolidColorBrush x:Key="AccentOnBrush" Color="#0F1F0A" />
                    <SolidColorBrush x:Key="CoverScrimBrush" Color="#B30E0E0E" />
                    <LinearGradientBrush x:Key="CoverFadeDownBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000E0E0E" Offset="0" />
                        <GradientStop Color="#9E0E0E0E" Offset="0.55" />
                        <GradientStop Color="#FF0E0E0E" Offset="1" />
                    </LinearGradientBrush>

                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1,1,1,1</Thickness>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#3A3A3A" />

                    <!-- 输入控件统一形态（暗色）。
                         WinUI 的 TextBox / PasswordBox 模板读这一组键，自绘的
                         TextInput / SearchBox / SelectBox 外壳也直接用它，
                         在这里覆盖一次，全应用输入框同时统一，不必逐页写内联样式。
                         注意 TextControlBackground 系列必须是 Brush 而不是 Color，
                         写成 Color 会在模板解析时抛类型不匹配（编译期不报）。
                         色差处理：底色改成「压在所在表面上的半透明黑」（#40000000）而不是固定深灰 ——
                         输入框嵌在卡片/亚克力里时，实心 #161616 比卡片沉一档，看着就是一块板。
                         PointerOver / Focused / Disabled 一律置透明：悬停与聚焦反馈由自绘外壳
                         （Shell）负责，模板里那层 BorderElement 再涂一次就会叠出第二条深色带。 -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#40000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#00000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#00000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#00000000" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#303030" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3E3E3E" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#242424" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#6E6E6E" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7A7A7A" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#5A5A5A" />
                    <!-- 自制下拉（Views/SelectBox）下拉面板读的键。
                         外壳本身复用上面那组 TextControl* 键（与 TextInput / SearchBox 同源），
                         只有面板与列表项要单独一套：面板必须近乎实心才压得住身后内容，
                         列表项的悬停 / 选中两档也要有明确对比。 -->
                    <SolidColorBrush x:Key="DropDownBackgroundBrush" Color="#F01F1F1F" />
                    <SolidColorBrush x:Key="DropDownBorderBrush" Color="#383838" />
                    <SolidColorBrush x:Key="DropDownItemBackgroundPointerOver" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="DropDownItemBackgroundSelected" Color="#333333" />
                    <!-- 列表 / 选择框的悬停与选中底色。WinUI 默认取系统强调色（蓝），
                         与启动器的绿色强调、极简单色配色直接冲突：头像浮层里选中当前账号
                         就是一块亮蓝。统一改成「半透明叠加 + 强调色淡底」，
                         压在实心卡片或亚克力浮层上都不会显脏。 -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#337CBD4B" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#4D7CBD4B" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#407CBD4B" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="#1F7CBD4B" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#F0F0F0" />
                    <!-- 紧凑展开器（AppCompactExpanderStyle）读的那几个键。
                         Expander 模板不认 Style.HeaderStyle，而是把 Header 做成 ToggleButton，
                         直接读 ExpanderHeaderBackground/BorderBrush/BorderThickness 与
                         ExpanderHeaderForeground（经视觉状态再叠 PointerOver / Pressed 两档）。
                         全部置透明 + 零边，标题才退化成一颗纯文字按钮。 -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="ExpanderHeaderForegroundPointerOver" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="ExpanderHeaderForegroundPressed" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderDisabledBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderDisabledForeground" Color="#5A5A5A" />
                    <SolidColorBrush x:Key="ExpanderChevronForeground" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderHeaderPadding">8,4,4,4</Thickness>
                </ResourceDictionary>

                <!-- WinUI 模板按 "Default" 解析暗色覆盖，内容与 Dark 对齐 -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E0E0E" />
                    <SolidColorBrush x:Key="BarBackgroundBrush" Color="#0E0E0E" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2D2D2D" />
                    <!-- 无卡片分栏用的「凹陷地面」：比页面底色更沉一档，用来承载输入区/房间码这类内容 -->
                    <SolidColorBrush x:Key="RecessedBackgroundBrush" Color="#59000000" />
                    <SolidColorBrush x:Key="RecessedBorderBrush" Color="#262626" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E9E9E" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#151515" />
                    <!-- 卡片底色：WinUI 原生亚克力（in-app backdrop）。
                         XAML 里声明成实心（1 / 1），因为没开全景时卡片本来就该是实心；
                         开全景后由 ThemeService.RefreshCardFrostTint 把 TintOpacity 与
                         TintLuminosityOpacity 一起降下来，卡片才真正透出并糊出身后的全景。
                         两个都要降：只降 TintOpacity 会被亮度浓度顶回去，看着还是实心。 -->
                    <AcrylicBrush x:Key="CardAcrylicBrush" TintColor="#151515" TintOpacity="1"
                                  TintLuminosityOpacity="1" FallbackColor="#1F1F1F" />
                    <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="#101010" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#141414" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0E0E0E" />
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="NeutralButtonBrush" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="NeutralButtonForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="GhostButtonForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="GhostButtonForegroundHover" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="ChromeTextBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="DangerButtonBrush" Color="#3A2222" />
                    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="#E8B4B4" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B2A1B" />
                    <SolidColorBrush x:Key="AccentSoftForegroundBrush" Color="#7CBD4B" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#808080" />

                    <!-- 自绘弹窗的遮罩（与 Dark 一致：WinUI 模板按 "Default" 解析暗色覆盖） -->
                    <SolidColorBrush x:Key="DialogScrimBrush" Color="#A8000000" />

                    <SolidColorBrush x:Key="AccentBrush" Color="#7CBD4B" />
                    <SolidColorBrush x:Key="AccentDarkBrush" Color="#5B8731" />
                    <SolidColorBrush x:Key="AccentOnBrush" Color="#0F1F0A" />
                    <SolidColorBrush x:Key="CoverScrimBrush" Color="#B30E0E0E" />
                    <LinearGradientBrush x:Key="CoverFadeDownBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000E0E0E" Offset="0" />
                        <GradientStop Color="#9E0E0E0E" Offset="0.55" />
                        <GradientStop Color="#FF0E0E0E" Offset="1" />
                    </LinearGradientBrush>

                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1,1,1,1</Thickness>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#3A3A3A" />

                    <!-- 输入控件统一形态：与 Dark 完全一致（WinUI 模板按 "Default" 解析暗色覆盖） -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#40000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#00000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#00000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#00000000" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#303030" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3E3E3E" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#242424" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#6E6E6E" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7A7A7A" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#5A5A5A" />
                    <!-- 自制下拉（Views/SelectBox）下拉面板读的键。
                         外壳本身复用上面那组 TextControl* 键（与 TextInput / SearchBox 同源），
                         只有面板与列表项要单独一套：面板必须近乎实心才压得住身后内容，
                         列表项的悬停 / 选中两档也要有明确对比。 -->
                    <SolidColorBrush x:Key="DropDownBackgroundBrush" Color="#F01F1F1F" />
                    <SolidColorBrush x:Key="DropDownBorderBrush" Color="#383838" />
                    <SolidColorBrush x:Key="DropDownItemBackgroundPointerOver" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="DropDownItemBackgroundSelected" Color="#333333" />
                    <!-- 列表 / 选择框的悬停与选中底色。WinUI 默认取系统强调色（蓝），
                         与启动器的绿色强调、极简单色配色直接冲突：头像浮层里选中当前账号
                         就是一块亮蓝。统一改成「半透明叠加 + 强调色淡底」，
                         压在实心卡片或亚克力浮层上都不会显脏。 -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#337CBD4B" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#4D7CBD4B" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#407CBD4B" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="#1F7CBD4B" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#F0F0F0" />
                    <!-- 紧凑展开器（AppCompactExpanderStyle）读的那几个键。
                         Expander 模板不认 Style.HeaderStyle，而是把 Header 做成 ToggleButton，
                         直接读 ExpanderHeaderBackground/BorderBrush/BorderThickness 与
                         ExpanderHeaderForeground（经视觉状态再叠 PointerOver / Pressed 两档）。
                         全部置透明 + 零边，标题才退化成一颗纯文字按钮。 -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="ExpanderHeaderForegroundPointerOver" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="ExpanderHeaderForegroundPressed" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderDisabledBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderDisabledForeground" Color="#5A5A5A" />
                    <SolidColorBrush x:Key="ExpanderChevronForeground" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderHeaderPadding">8,4,4,4</Thickness>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="BarBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#E8E8E8" />
                    <!-- 无卡片分栏用的「凹陷地面」：亮色下比页面底色更实一档，方向同样是「沉下去」 -->
                    <SolidColorBrush x:Key="RecessedBackgroundBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="RecessedBorderBrush" Color="#D4D4D4" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#D4D4D4" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <!-- 卡片底色：WinUI 原生亚克力（in-app backdrop）。
                         XAML 里声明成实心（1 / 1），因为没开全景时卡片本来就该是实心；
                         开全景后由 ThemeService.RefreshCardFrostTint 把 TintOpacity 与
                         TintLuminosityOpacity 一起降下来，卡片才真正透出并糊出身后的全景。
                         两个都要降：只降 TintOpacity 会被亮度浓度顶回去，看着还是实心。 -->
                    <AcrylicBrush x:Key="CardAcrylicBrush" TintColor="#FFFFFF" TintOpacity="1"
                                  TintLuminosityOpacity="1" FallbackColor="#F3F3F3" />
                    <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#ECECEC" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="NeutralButtonBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="NeutralButtonForegroundBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="GhostButtonForeground" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="GhostButtonForegroundHover" Color="#888888" />
                    <SolidColorBrush x:Key="ChromeTextBrush" Color="#222222" />
                    <SolidColorBrush x:Key="DangerButtonBrush" Color="#F3D6D6" />
                    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="#8A2B2B" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E2EDD6" />
                    <SolidColorBrush x:Key="AccentSoftForegroundBrush" Color="#5B8731" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#767676" />

                    <!-- 自绘弹窗的遮罩（亮色下用浅灰而不是纯黑，
                         纯黑遮罩配白卡片会显得弹窗像「贴在黑板上」，与整体亮色风格割裂） -->
                    <SolidColorBrush x:Key="DialogScrimBrush" Color="#7A9A9A9A" />

                    <SolidColorBrush x:Key="AccentBrush" Color="#7CBD4B" />
                    <SolidColorBrush x:Key="AccentDarkBrush" Color="#5B8731" />
                    <SolidColorBrush x:Key="AccentOnBrush" Color="#0F1F0A" />
                    <SolidColorBrush x:Key="CoverScrimBrush" Color="#B3F3F3F3" />
                    <LinearGradientBrush x:Key="CoverFadeDownBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00F3F3F3" Offset="0" />
                        <GradientStop Color="#9EF3F3F3" Offset="0.55" />
                        <GradientStop Color="#FFF3F3F3" Offset="1" />
                    </LinearGradientBrush>

                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1,1,1,1</Thickness>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#D4D4D4" />

                    <!-- 输入控件统一形态（亮色）：白底 + 浅灰边框，聚焦时边框压深一档 -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#8CFFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#00000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#00000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#00000000" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#CFCFCF" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#B0B0B0" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#767676" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#767676" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#B0B0B0" />
                    <!-- 自制下拉（Views/SelectBox）下拉面板读的键，见暗色块的同类注释 -->
                    <SolidColorBrush x:Key="DropDownBackgroundBrush" Color="#F5FFFFFF" />
                    <SolidColorBrush x:Key="DropDownBorderBrush" Color="#D4D4D4" />
                    <SolidColorBrush x:Key="DropDownItemBackgroundPointerOver" Color="#EDEDED" />
                    <SolidColorBrush x:Key="DropDownItemBackgroundSelected" Color="#E4E4E4" />
                    <!-- 亮色下的列表悬停 / 选中底色，理由见暗色块的同类注释 -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14000000" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#0A000000" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#2E7CBD4B" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#407CBD4B" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#335B8731" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="#1A7CBD4B" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#1A1A1A" />
                    <!-- 紧凑展开器（AppCompactExpanderStyle）读的那几个键。
                         Expander 模板不认 Style.HeaderStyle，而是把 Header 做成 ToggleButton，
                         直接读 ExpanderHeaderBackground/BorderBrush/BorderThickness 与
                         ExpanderHeaderForeground（经视觉状态再叠 PointerOver / Pressed 两档）。
                         全部置透明 + 零边，标题才退化成一颗纯文字按钮。 -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="#5F5F5F" />
                    <SolidColorBrush x:Key="ExpanderHeaderForegroundPointerOver" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="ExpanderHeaderForegroundPressed" Color="#000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderDisabledBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderHeaderDisabledForeground" Color="#B0B0B0" />
                    <SolidColorBrush x:Key="ExpanderChevronForeground" Color="#5F5F5F" />
                    <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderHeaderPadding">8,4,4,4</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 全局无衬线：微软雅黑 UI，避免中文回退到宋体 -->
            <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Microsoft YaHei, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI, Microsoft YaHei, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>

            <!-- 图标字体：Fluent UI System Icons Filled（微软官方，MIT）。
                 换用原因：Windows 自带的 Segoe Fluent Icons 是单一线框字重，
                 全字体 2005 个字形里没有任何实心（fill）变体，无法只靠改属性实现
                 「图标填充化」，因此整体改用本字体的 Filled 家族。
                 注意：必须逐元素显式指定，不能写全局隐式 <Style TargetType="FontIcon">，
                 否则会连带改掉 WinUI 内置模板（TextBox 清除按钮、DatePicker 上下箭头等）
                 的 FontIcon —— 那些 Glyph 仍是 Segoe 码位，换字体后会显示成别的图标。 -->
            <FontFamily x:Key="IconFontFamily">ms-appx:///Assets/Fonts/FluentSystemIcons-Filled.ttf#FluentSystemIcons-Filled</FontFamily>

            <!-- ==================== 输入控件统一形态 ====================
                 全应用 28 个输入框共用这一套几何与状态。颜色不在这里，
                 全部走上面三个主题字典里的 TextControl* / DropDown* 键 —— 这样
                 「形状只有一个来源、颜色也只有一个来源」，页面里不再出现任何
                 Background / BorderBrush / CornerRadius / Height 的内联输入框写法。

                 为什么用主题键而不是重写 ControlTemplate：
                 重写模板要连模板里的 TextBoxDeleteButton / 占位符 / 选择高亮一起复制，
                 拷贝一多就必然与 WinUI 版本脱节（升级后模板结构变了，编译不报、运行才崩）。
                 覆盖资源键是官方支持的定制面，模板结构仍由 WinUI 自己维护。 -->

            <!-- 紧凑展开器：把常驻长段说明收起来，只在用户主动展开时占高度。
                 WinUI 默认 Expander 是「48 高 + 带边框的整块」形态（ExpanderMinHeight=48、
                 ExpanderContentPadding=16、BorderThickness 1,0,1,1），塞进工具条会把行高顶到 48。
                 这里把最小高、内边距、边框全部归零，视觉上退化成一颗文字按钮。
                 注意 MinWidth：默认吃 FlyoutThemeMinWidth(=96)，右侧对齐时会把标题推离边缘。
                 **不要再写 HeaderStyle** —— Expander 模板不读这个属性，它经视觉状态
                 （ExpandUp/ExpandDown）挂 `ExpanderHeaderUpStyle` / `ExpanderHeaderDownStyle`，
                 并且 Header 的 Background/Border/Padding 直接读下面那几个 ThemeResource 键。
                 写 HeaderStyle 是死键，不报错、只是完全没反应。

                 **这条样式不能写 BasedOn**，两种写法都是死路，别再试第三次：
                   · BasedOn="{ThemeResource DefaultExpanderStyle}" → 编译期直接拒绝，
                     WMC0141「Style BasedOn property must be a Style, not
                     'ThemeResourceExtension' object」：BasedOn 要的是一个**已存在的
                     Style 对象**，ThemeResource 是延后解析的标记扩展，给不出对象。
                   · BasedOn="{StaticResource DefaultExpanderStyle}" → **编译期零报错**，
                     但解析期取不到对象，运行期抛 XamlParseException
                     「Cannot find a Resource with the Name/Key DefaultExpanderStyle」。
                     原因不是 XCR 没合并，而是**查找作用域**：App.xaml 根字典本层声明
                     的样式，`StaticResource` 只查「自己 + 自己 MergedDictionaries 的项」，
                     够不到根字典顶部那份 XamlControlsResources。
                     实测：App.xaml 顶部有 XCR、443 行这里写 StaticResource 时，
                     仍然精确抛在这一行（Position 74 正是 BasedOn 的值起点）。

                 所以正解是**根本不依赖外部样式**：不写 BasedOn，让 Expander 模板走
                 WinUI 的隐式默认样式。上面那七个 Setter 才是我们真正要覆盖的东西，
                 它们对默认模板同样生效。代价为零、风险为零。
                 （同类前科：DefaultListViewStyle 在 2026-09-03 踩过一模一样的坑，
                 当时的处置也是最终去掉了对外部样式的引用。） -->
            <Style x:Key="AppCompactExpanderStyle" TargetType="Expander">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <!-- 刻意**不写 BasedOn**，让模板走隐式样式回落：
                     显式 BasedOn 指向 WinUI 自带样式（DefaultExpanderStyle 等）时，
                     解析期要跨字典取对象，而本层查不到根字典顶部的 XamlControlsResources
                     → 运行期 XamlParseException，且编译期完全查不出来（已实测两次）。
                     不写 BasedOn，模板由 WinUI 默认样式（同 TargetType）提供，
                     视觉行为与「BasedOn 默认样式」等价，但少了一处解析期依赖 ——
                     这是本文件里唯一一个不写 BasedOn 的样式，别顺手「补齐」。 -->
            </Style>

            <!-- Expander 的**隐式**样式：SkinsPage 里两颗 Expander 都靠它吃到上面的紧凑几何。
                 页面侧刻意不再写 Style="{StaticResource AppCompactExpanderStyle}" ——
                 显式 StaticResource 一旦解析失败就是**整页 XamlParseException、窗口都出不来**；
                 走隐式回落则最多是「样式没生效」，不会把页面打死。少一次显式引用，就少一个炸点。 -->
            <Style TargetType="Expander" BasedOn="{StaticResource AppCompactExpanderStyle}" />

            <!-- 单行输入框：40 高，与 NeutralActionButtonStyle(32) 组成「输入 + 动作」一行时
                 需要显式对齐，故高度收敛到 40 这一档；圆角 6 与 AppButtonStyle 同族。

                 垂直居中为什么必须靠 Padding 而不是 VerticalContentAlignment：
                 WinUI 模板里 ContractElement 是 ScrollViewer，它的 VerticalAlignment 绑
                 VerticalContentAlignment —— 但 ScrollViewer 的**内容**不会跟着居中，
                 它只会把自身贴到中间、内容仍从顶部排。所以唯一可靠的对中办法是把
                 上下 Padding 写成对称值，让内容区恰好等于一行文字高。
                 40 高 − 2×1 边框 = 38 内容高；微软雅黑 UI 在 13px 下实测行高 17.16
                 → (38 − 17.16)/2 ≈ 10.4，取整 10。上下都写 10，文字才落在几何中线上。
                 （模板默认 TextControlThemePadding 是 10,5,6,6，上下 5/6 不等 —— 这正是
                 「文字偏上」的来源；只把下面的 Padding 调大是治标，必须两边相等。） -->
            <Style x:Key="AppTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="11,10,7,10" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 多行输入框：撑满宽度、可纵向拉伸（AI 输入框 / 日志摘录） -->
            <Style x:Key="AppMultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="11,9,11,9" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <!-- 内联输入框：贴在自定义容器（如搜索条 Border）内部，自身不带底与边，
                 由外层容器画整个输入区的外壳 —— 避免「框里套框」的双层边框。 -->
            <Style x:Key="AppInlineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="4,11,6,11" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="AcceptsReturn" Value="False" />
            </Style>

            <!-- 表格 / 日志用的等宽只读框（崩溃摘录这类需要列对齐的场合） -->
            <Style x:Key="AppMonospaceBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,8,10,8" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <!-- ==================== 设置行（设置页 / 版本设置共用） ====================
                 一条设置 = 一行：标题在上、说明紧跟其后，控件靠右对齐；
                 控件很宽（目录、Java、滑块、参数框）时改用块状行，控件通栏摆在说明下面。
                 卡片按分组切，行与行之间用 CardDividerStyle 的 1px 分隔线。 -->
            <Style x:Key="SettingRowStyle" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="18" />
                <Setter Property="Padding" Value="18,13,18,13" />
            </Style>
            <Style x:Key="SettingBlockStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="7" />
                <Setter Property="Padding" Value="18,13,18,13" />
            </Style>
            <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SettingHintStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldHintStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxWidth" Value="620" />
            </Style>
            <!-- 开关不再自带 Header 文字（标题已在左侧），只留 On/Off 与最小宽度 -->
            <Style x:Key="SettingSwitchStyle" TargetType="ToggleSwitch">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="OnContent" Value="已开启" />
                <Setter Property="OffContent" Value="已关闭" />
            </Style>
            <!-- 分组顶栏页签（与下载页的分类顶栏同一套尺寸与选中态） -->
            <Style x:Key="SettingsTabButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            </Style>

            <!-- 滑块：只统一强调色与垂直居中，尺寸留给页面定（设置页要 360 宽，版本设置要撑满） -->
            <Style x:Key="AppSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
                <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 开关：Header 与 On/OffContent 的字号统一到 12 -->
            <Style x:Key="AppToggleSwitchStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- ==================== 隐式样式（未显式指定 Style 的控件自动套用） ====================
                 全部 BasedOn 上面对应的具名样式：页面里写 `Style="{StaticResource AppTextBoxStyle}"`
                 与完全不写效果一致，这样老页面不用逐个改也不会漏掉新形态。
                 唯一的例外是底下几个：它们要保持与全局不同的形，必须显式指定具名样式覆盖。 -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            </Style>
            <Style TargetType="RichTextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}" />
            <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="11,0,7,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            </Style>
            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource AppToggleSwitchStyle}" />
            <Style TargetType="Slider" BasedOn="{StaticResource AppSliderStyle}" />
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            </Style>
            <Style x:Key="AppButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
                <Setter Property="Foreground" Value="{ThemeResource GhostButtonForeground}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="Content"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Foreground" Value="{ThemeResource GhostButtonForegroundHover}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Foreground" Value="{ThemeResource GhostButtonForegroundHover}" />
                                                <Setter Target="RootGrid.Opacity" Value="0.92" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}" />

            <!--
                ==================== UI 基础样式层（全应用唯一来源） ====================
                页面里不要再各自重写「卡片 / 标题 / chip」——统一引用这里的键。
                统一的含义是：外观要调就改这一处，全应用一起变。
                这些样式刻意放在 ThemeDictionaries 之外：它们的 Setter 用 ThemeResource，
                颜色仍随亮暗主题切换，只有尺寸/字重这类不随主题变的东西才写在这里。
            -->

            <!-- 间距令牌：页面留白 / 卡片内边距 / 卡片间距 / 分区间距 -->
            <Thickness x:Key="PagePaddingThickness">32,24,32,24</Thickness>
            <Thickness x:Key="CardPaddingThickness">18,16</Thickness>
            <Thickness x:Key="CardGapThickness">0,0,0,8</Thickness>
            <Thickness x:Key="SectionGapThickness">0,20,0,0</Thickness>

            <!-- 页面卡片：卡片底 + 1px 分割线 + 圆角 10 + 内边距 18,16。
                 注意 WinUI 的 Border.CornerRadius 只裁自身的 Background/BorderBrush，
                 不裁子元素几何 —— 圆角卡片里要放整块图片时，必须把 ImageBrush 放到
                 Border 的 Background 上，不要写成 <Border CornerRadius="10"><Image/></Border>。 -->
            <Style x:Key="PageCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardAcrylicBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="{StaticResource CardPaddingThickness}" />
            </Style>

            <!-- 加载态小卡片：转环 + 一句文案统一装进这颗卡，别再让转环裸浮在页面上。
                 和 PageCardStyle 同一套底色 / 描线 / 圆角（全景模式下会被卡片毛玻璃层一起糊，
                 与页面其他卡片表现一致），只是内边距更松一点，让转环有呼吸空间。
                 x:Name 要打在**这颗 Border 上**（不是里面的 StackPanel）：
                 代码切 Visibility 时若只切里面的内容，会留下一块空卡片。 -->
            <Style x:Key="LoadingCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardAcrylicBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="26,20" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 字号阶梯：全应用只有下面这几档，不要在页面里临时写死别的号数。
                 分区 18 SemiBold / 卡标题 14 SemiBold / 小节标签 12 SemiBold 次要 /
                 字段名 12 次要 / 提示 11 次要 + 换行 -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="MetaTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>
            <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>
            <Style x:Key="FieldHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <!-- 连接地址展示框：等宽、放大一档、强调色字。
                 地址是要给人抄的（复制到手机会话里发好友），所以字号比普通正文大，
                 且必须可选可复制。刻意不收成按钮样式 —— 它要能整段选中。
                 字体栈直接写死：App.xaml 里没有等宽的具名 TextBlock 样式，
                 借用 AppMonospaceBoxStyle（那是 TextBox 的）会 WMC0001。 -->
            <Style x:Key="TunnelAddressStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{ThemeResource AccentSoftForegroundBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <!-- 穿透状态圆点：只画一个 8×8 的实心圆，颜色由代码按状态设。
                 这里只固定尺寸与居中，不固定颜色 —— 颜色走代码里的 ThemeService.Brush。
                 TargetType 必须用上面声明的 shapes: 前缀：App.xaml 的默认 xmlns 虽然带
                 presentation 命名空间，但写全限定名 'Microsoft.UI.Xaml.Shapes.Ellipse'
                 会被 XAML 编译器判为 WMC0110（照字符串找类型，不做 CLR 类型解析）。 -->
            <Style x:Key="TunnelStatusDotStyle" TargetType="shapes:Ellipse">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 卡内分割线：1px 实线，高度靠自身撑，别用 BorderThickness 模拟 -->
            <Style x:Key="CardDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DividerBrush}" />
            </Style>

            <!-- ==================== 无卡片分栏（快捷联机页在用） ====================
                 取消卡片背景后，原先靠「卡片轮廓」划分的区块改由这两件套表达：
                 左侧 2px 强调色竖线 + 其右的内容组。竖线只做视觉归属，不占据独立列宽之外的空间。
                 为什么不用背景色块：本应用页面底色就是 AppBackgroundBrush，
                 再叠一层浅色块等于把刚去掉的卡片换个颜色加回来。 -->
            <Style x:Key="SectionTitleBarStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2,0,0,0" />
                <Setter Property="Padding" Value="12,0,0,0" />
            </Style>

            <!-- 分栏之间的横向分隔：整幅通栏的一条 1px 线，比卡片边框轻，但足以切开区块 -->
            <Style x:Key="SectionDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DividerBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!-- chip（分类标签 / 筛选标签）：只定形制，不定颜色 ——
                 选中态由代码改写 Background/Foreground（如资源库的 ApplyKindVisual）。
                 必须 BasedOn AppButtonStyle：不写的话会落到 WinUI 默认 Button 模板，
                 它的视觉状态会盖掉代码设置的 Background。 -->
            <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource ChipBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource GhostButtonForeground}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 动作按钮三档：主操作 / 中性 / 危险。
                 页面里别再内联写「Background + Foreground + BorderThickness=0 + Height + Padding +
                 CornerRadius + FontSize」这一串，直接套样式；
                 尺寸只在一处，改了全应用一起变。 -->
            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AccentOnBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="NeutralActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource NeutralButtonBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource NeutralButtonForegroundBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource DangerButtonBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource DangerButtonForegroundBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 图标版按钮：上面几档的 Padding 是按「12px 中文两三个字」定的，
                 换成 16px 字形后左右留白过宽（14 → 整颗 44px），视觉上是一排胖方块。
                 这里只收几何，配色 / 高度 / 圆角仍然跟着各自档位走，
                 所以同一行里文字按钮与图标按钮的高度、圆角一定一致。
                 图标按钮没有文字，ToolTipService.ToolTip 是唯一释义面，必须配；
                 ToolTip 文案要和被它替换掉的那句中文一样长（含括号里的补充说明）。 -->
            <Style x:Key="ChipIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                <Setter Property="Padding" Value="11,0" />
            </Style>
            <Style x:Key="NeutralActionIconButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralActionButtonStyle}">
                <Setter Property="Padding" Value="11,0" />
            </Style>
            <Style x:Key="DangerActionIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerActionButtonStyle}">
                <Setter Property="Padding" Value="11,0" />
            </Style>

            <!-- 卡片标题行 = 整行可点的折叠按钮（标题靠左、chevron 靠右）。
                 AppButtonStyle 的模板把 RootGrid 绑到 Background，且 PointerOver 只改字形前景、
                 不写 Background，所以 Transparent 的底色不会被悬停状态顶掉 —— 悬停时整行不会有底色变化，
                 可点性完全靠右侧 chevron 表达（展开=朝上，收起=朝下），别再往这里加底色 hover。
                 HorizontalContentAlignment 必须 Stretch：默认 Center 会把标题甩到行中间。 -->
            <Style x:Key="SectionToggleHeaderStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
