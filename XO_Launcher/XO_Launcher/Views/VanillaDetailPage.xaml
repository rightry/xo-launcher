<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.VanillaDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:XO_Launcher.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 步骤条的一枚步骤。整页只有向导用得到，故写在本页而不是 App.xaml。
             选中/完成态由代码改 Badge/Label 的画刷，这里只给未到达的默认外观。 -->
        <Style x:Key="WizardStepButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- 向导版式：顶部版本身份条常驻 → 步骤条 → 当前步骤内容 → 底部导航/主按钮。
         一次只回答一个问题（加载器 / 加载器版本 / 命名 / 确认），原来四张卡片堆在一屏里
         要靠滚动找，且「下载并安装」离它要安装的东西最远。 -->
    <Grid Background="{ThemeResource AppBackgroundBrush}" Padding="24,14,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button x:Name="BackButton" Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF15B;" FontSize="14"
                          Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="返回版本列表" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- 版本身份条：装到哪个版本这件事必须一直看得见 -->
        <Border Grid.Row="1" Style="{StaticResource PageCardStyle}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBorder" Width="44" Height="44" CornerRadius="10" Background="{ThemeResource AccentBrush}">
                    <TextBlock Text="MC" FontSize="14" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border x:Name="TypeChip" Background="{ThemeResource AccentSoftBrush}" CornerRadius="4"
                                Padding="8,3" VerticalAlignment="Center">
                            <TextBlock x:Name="TypeText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentBrush}" />
                        </Border>
                        <TextBlock x:Name="MetaText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="DescriptionText" Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 步骤条 -->
        <Border Grid.Row="2" Style="{StaticResource PageCardStyle}" Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="Step1Button" Tag="1" Style="{StaticResource WizardStepButtonStyle}" Click="StepChip_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="Step1Badge" Width="22" Height="22" CornerRadius="11"
                                Background="{ThemeResource ChipBackgroundBrush}">
                            <TextBlock x:Name="Step1BadgeText" Text="1" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="Step1Label" Text="模组加载器" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Rectangle Width="18" Height="1" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Center" />
                <Button x:Name="Step2Button" Tag="2" Style="{StaticResource WizardStepButtonStyle}" Click="StepChip_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="Step2Badge" Width="22" Height="22" CornerRadius="11"
                                Background="{ThemeResource ChipBackgroundBrush}">
                            <TextBlock x:Name="Step2BadgeText" Text="2" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="Step2Label" Text="加载器版本" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Rectangle Width="18" Height="1" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Center" />
                <Button x:Name="Step3Button" Tag="3" Style="{StaticResource WizardStepButtonStyle}" Click="StepChip_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="Step3Badge" Width="22" Height="22" CornerRadius="11"
                                Background="{ThemeResource ChipBackgroundBrush}">
                            <TextBlock x:Name="Step3BadgeText" Text="3" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="Step3Label" Text="游戏名称" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Rectangle Width="18" Height="1" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Center" />
                <Button x:Name="Step4Button" Tag="4" Style="{StaticResource WizardStepButtonStyle}" Click="StepChip_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="Step4Badge" Width="22" Height="22" CornerRadius="11"
                                Background="{ThemeResource ChipBackgroundBrush}">
                            <TextBlock x:Name="Step4BadgeText" Text="4" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="Step4Label" Text="确认安装" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Rectangle Width="18" Height="1" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Center" />
                <Button x:Name="Step5Button" Tag="5" Style="{StaticResource WizardStepButtonStyle}" Click="StepChip_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="Step5Badge" Width="22" Height="22" CornerRadius="11"
                                Background="{ThemeResource ChipBackgroundBrush}">
                            <TextBlock x:Name="Step5BadgeText" Text="5" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="Step5Label" Text="安装结果" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <StackPanel Padding="0,0,0,4">

                <!-- 步骤 1：加载器 -->
                <StackPanel x:Name="Step1Panel" Spacing="10">
                    <TextBlock Text="要装哪种模组加载器？" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap"
                               Text="只玩原版可以选第一项；想玩模组再装加载器。加载器之后也能在版本设置里补装，但重装比补装省事。" />
                    <StackPanel Spacing="6">
                        <!-- 每个加载器配一枚图标：五项文字长短接近，扫视时靠字形区分比靠首字快。
                             码点取自 Assets/Fonts/FluentSystemIcons-Filled.ttf（已核对）：
                             cube F335 / puzzle_piece E9F1 / fire EF69 / wrench EE86 / layer F4D5。 -->
                        <Button x:Name="CardVanilla" Tag="vanilla" Click="LoaderCard_Click" Height="58"
                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="14,0"
                                HorizontalContentAlignment="Left">
                            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF335;"
                                          FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="原版" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="不装加载器，最接近官方启动器" FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="CardFabric" Tag="fabric" Click="LoaderCard_Click" Height="58"
                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="14,0"
                                HorizontalContentAlignment="Left">
                            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE9F1;"
                                          FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Fabric" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="轻量、模组生态最活跃，新版本跟进最快" FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="CardForge" Tag="forge" Click="LoaderCard_Click" Height="58"
                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="14,0"
                                HorizontalContentAlignment="Left">
                            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xEF69;"
                                          FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Forge" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="老牌，大型整合包多用它" FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="CardNeoForge" Tag="neoforge" Click="LoaderCard_Click" Height="58"
                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="14,0"
                                HorizontalContentAlignment="Left">
                            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xEE86;"
                                          FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="NeoForge" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="Forge 的分叉，较新版本的主流选择" FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="CardQuilt" Tag="quilt" Click="LoaderCard_Click" Height="58"
                                HorizontalAlignment="Stretch" CornerRadius="8" Padding="14,0"
                                HorizontalContentAlignment="Left">
                            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF4D5;"
                                          FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Quilt" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="Fabric 的分支，可用模组较少" FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- 步骤 2：加载器版本（原版会整步跳过） -->
                <StackPanel x:Name="Step2Panel" Spacing="10" Visibility="Collapsed">
                    <StackPanel x:Name="LoaderVersionPanel" Spacing="10">
                        <TextBlock x:Name="LoaderVersionStepTitle" Text="选加载器版本" Style="{StaticResource CardTitleStyle}" />
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="LoaderVersionLabel" Text="加载器版本" FontSize="12"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <views:SelectBox x:Name="LoaderVersionBox" HorizontalAlignment="Stretch"
                                             PlaceholderText="选择加载器版本" SelectionChanged="LoaderVersionBox_SelectionChanged" />
                            <ToggleSwitch x:Name="ShowAllLoaderToggle" Header="显示全部加载器版本"
                                          OnContent="全部" OffContent="仅稳定 / 正式" FontSize="12"
                                          Visibility="Collapsed" Toggled="ShowAllLoaderToggle_Toggled" />
                        </StackPanel>
                        <Border x:Name="FabricApiPanel" Background="{ThemeResource CardAltBackgroundBrush}"
                                CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <ToggleSwitch x:Name="FabricApiToggle" Header="安装 Fabric API" OnContent="安装"
                                              OffContent="不安装" IsOn="True" FontSize="12" />
                                <TextBlock Style="{StaticResource FieldHintStyle}"
                                           Text="Fabric API 是多数 Fabric 模组的必要依赖" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="LoaderStatusText" Style="{StaticResource FieldHintStyle}"
                                   TextWrapping="Wrap" Tapped="LoaderStatusText_Tapped" />
                    </StackPanel>
                </StackPanel>

                <!-- 步骤 3：命名 -->
                <StackPanel x:Name="Step3Panel" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="给这个实例起个名字" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap"
                               Text="名字就是 versions 下的文件夹名，之后在版本列表里看到的就是它。" />
                    <views:TextInput x:Name="GameNameBox" PlaceholderText="例如：我的世界26.2"
                                     TextChanged="GameNameBox_TextChanged" />
                    <TextBlock x:Name="FolderHintText" FontSize="11" Foreground="{ThemeResource AccentBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 步骤 4：确认 -->
                <StackPanel x:Name="Step4Panel" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="确认安装内容" Style="{StaticResource CardTitleStyle}" />
                    <Border Background="{ThemeResource CardAltBackgroundBrush}" CornerRadius="8" Padding="14,12">
                        <TextBlock x:Name="SummaryText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- 步骤 5：安装进行中 / 结果。安装一旦开始就停在这儿，
                     页面上不再留「下载并安装」这类可重复触发的按钮，只有「完成」。 -->
                <StackPanel x:Name="Step5Panel" Spacing="10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing x:Name="InstallRing" Width="20" Height="20" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentBrush}" />
                        <TextBlock x:Name="Step5Title" Text="正在安装…" Style="{StaticResource CardTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- 安装结果横幅：系统 Toast 说的是「下载完成 / 名称」，这页也得当场给出同一句，
                         否则用户只能切到「消息」页才确认得了结果。 -->
                    <Border x:Name="ResultBanner" Background="{ThemeResource AccentSoftBrush}" CornerRadius="8"
                            Padding="14,12" Visibility="Collapsed">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="ResultIcon" Grid.Column="0" FontFamily="{StaticResource IconFontFamily}"
                                      Glyph="&#xF298;" FontSize="18" VerticalAlignment="Top" Margin="0,1,0,0"
                                      Foreground="{ThemeResource AccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="ResultTitleText" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock x:Name="ResultDetailText" Style="{StaticResource FieldHintStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="QueueTipBorder" Background="{ThemeResource CardAltBackgroundBrush}" CornerRadius="8"
                            Padding="12,8" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF4AA;" FontSize="13"
                                          Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="QueueTip" FontSize="12" Foreground="{ThemeResource AccentBrush}"
                                           TextWrapping="Wrap" MaxWidth="520" />
                            </StackPanel>
                            <TextBlock x:Name="InstallStepText" FontSize="12"
                                       Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部导航：第 4 步把「下一步」换成主按钮，安装动作离确认信息最近 -->
        <Grid Grid.Row="4" Background="{ThemeResource SidebarBackgroundBrush}"
              BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0"
              Padding="0,12,0,14" Margin="-24,0,-24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PrevButton" Content="上一步" Style="{StaticResource NeutralActionButtonStyle}"
                    Click="PrevButton_Click" />
            <!-- 第 5 步（安装结果）：上一步与步骤提示都收起，「完成」独占正中间 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="12">
                <TextBlock x:Name="StepIndicatorText" Style="{StaticResource FieldHintStyle}"
                           VerticalAlignment="Center" />
                <Button x:Name="FinishButton" Content="完成" Style="{StaticResource PrimaryActionButtonStyle}"
                        Visibility="Collapsed" Click="FinishButton_Click" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="NextButton" Content="下一步" Style="{StaticResource PrimaryActionButtonStyle}"
                        Click="NextButton_Click" />
                <Button x:Name="InstallButton" Height="40" Visibility="Collapsed"
                        Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentOnBrush}"
                        BorderThickness="0" FontSize="14" FontWeight="Bold" CornerRadius="8" Padding="20,0"
                        Click="InstallButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF150;" FontSize="15"
                                  Foreground="{ThemeResource AccentOnBrush}" />
                        <TextBlock x:Name="InstallButtonText" Text="下载并安装" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
