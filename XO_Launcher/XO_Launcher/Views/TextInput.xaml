<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.TextInput"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    FontFamily="{ThemeResource AppFontFamily}"
    FontSize="13"
    Foreground="{ThemeResource TextPrimaryBrush}"
    MinHeight="40"
    VerticalAlignment="Center">

    <!-- 自制输入框：外壳（圆角、底色、悬停/聚焦描边）全部由本控件自绘，
         内部的 TextBox 只作为「接收键盘输入」的裸元件（透明、无边框、无聚焦视觉），
         不再依赖 WinUI TextBox 模板里那些无法主题化的键。单行/多行、只读、等宽、
         内嵌(Chromeless)、凹陷(Recessed) 等形态都由依赖属性驱动。 -->
    <UserControl.Resources>
        <Style x:Key="InnerInputStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="Shell"
            Background="{ThemeResource TextControlBackground}"
            BorderBrush="{ThemeResource TextControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="11,8,7,8">
        <TextBox x:Name="Input"
                 Style="{StaticResource InnerInputStyle}"
                 FontFamily="{Binding FontFamily, ElementName=Root}"
                 FontSize="{Binding FontSize, ElementName=Root}"
                 Foreground="{Binding Foreground, ElementName=Root}"
                 PlaceholderText="{Binding PlaceholderText, ElementName=Root}"
                 IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
                 AcceptsReturn="{Binding AcceptsReturn, ElementName=Root}"
                 TextWrapping="{Binding TextWrapping, ElementName=Root}"
                 TextAlignment="{Binding TextAlignment, ElementName=Root}" />
    </Border>
</UserControl>
