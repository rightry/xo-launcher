<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.WelcomeGate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:XO_Launcher.Views">

    <!-- 开门遮罩：新手引导 / 更新说明走完之前，主界面一直藏在它后面（看不见也点不到）。
         底色必须是实心的 BarBackgroundBrush：全景模式下 AppBackgroundBrush 是全透明的，
         拿它当遮罩底会直接漏出主界面。
         引导页下面挂的是真实操作区（登录 / 目录 / 安装 / 外观），不是纯图文介绍。 -->
    <Grid Background="{ThemeResource BarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="32,20,32,0">
            <TextBlock x:Name="EyebrowText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
            <StackPanel x:Name="DotsHost" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <StackPanel Width="680" HorizontalAlignment="Center" Padding="0,28,0,16" Spacing="16">
                <Border Width="56" Height="56" CornerRadius="14" Background="{ThemeResource AccentSoftBrush}"
                        HorizontalAlignment="Left">
                    <FontIcon x:Name="StepIcon" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF4AA;"
                              FontSize="24" Foreground="{ThemeResource AccentBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="StepTitle" FontSize="22" FontWeight="Bold"
                           Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" />
                <StackPanel x:Name="BulletsHost" Spacing="8" />

                <!-- 第 1 步：账号 -->
                <StackPanel x:Name="AccountPanel" Spacing="10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource PrimaryActionButtonStyle}" Content="微软正版登录"
                                Click="MicrosoftLogin_Click" />
                        <TextBlock x:Name="AccountStateText" Style="{StaticResource FieldHintStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <views:TextInput x:Name="OfflineNameBox" PlaceholderText="离线玩家名（没有正版账号时）" />
                        <Button Grid.Column="1" Style="{StaticResource NeutralActionButtonStyle}"
                                Content="添加离线账号" Click="AddOffline_Click" />
                    </Grid>
                    <TextBlock x:Name="AccountHintText" Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 第 2 步：游戏目录 -->
                <StackPanel x:Name="FolderPanel" Spacing="10" Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource CardAltBackgroundBrush}" CornerRadius="6"
                                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" Padding="12,8">
                            <TextBlock x:Name="GameDirText" Style="{StaticResource MetaTextStyle}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource NeutralActionButtonStyle}"
                                Content="更改目录" Click="ChangeFolder_Click" />
                    </Grid>
                    <TextBlock x:Name="FolderHintText" Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 第 3 步：装第一个版本 -->
                <StackPanel x:Name="InstallPanel" Spacing="10" Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <views:SelectBox x:Name="VersionCombo" HorizontalAlignment="Stretch"
                                         PlaceholderText="正在获取版本列表…" SelectionChanged="VersionCombo_SelectionChanged" />
                        <Button x:Name="InstallFirstButton" Grid.Column="1"
                                Style="{StaticResource PrimaryActionButtonStyle}" Content="安装"
                                Click="InstallFirst_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="InstallRing" Width="14" Height="14" Visibility="Collapsed"
                                      Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="InstallStateText" Style="{StaticResource FieldHintStyle}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- 第 4 步：外观 -->
                <StackPanel x:Name="PersonalizePanel" Spacing="12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ThemeSystemButton" Tag="system" Content="跟随系统" Click="Theme_Click"
                                Height="36" Padding="18,0" FontSize="13" BorderThickness="2" CornerRadius="6"
                                Background="{ThemeResource NeutralButtonBrush}"
                                Foreground="{ThemeResource NeutralButtonForegroundBrush}" />
                        <Button x:Name="ThemeDarkButton" Tag="dark" Content="暗色模式" Click="Theme_Click"
                                Height="36" Padding="18,0" FontSize="13" BorderThickness="2" CornerRadius="6"
                                Background="{ThemeResource NeutralButtonBrush}"
                                Foreground="{ThemeResource NeutralButtonForegroundBrush}" />
                        <Button x:Name="ThemeLightButton" Tag="light" Content="亮色模式" Click="Theme_Click"
                                Height="36" Padding="18,0" FontSize="13" BorderThickness="2" CornerRadius="6"
                                Background="{ThemeResource NeutralButtonBrush}"
                                Foreground="{ThemeResource NeutralButtonForegroundBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="PanoramaSwitch" Header="用游戏全景图当背景（卡片为毛玻璃）"
                                  FontSize="13" Toggled="Panorama_Toggled" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Background="{ThemeResource SidebarBackgroundBrush}"
              BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="32,14,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" Content="跳过" Style="{StaticResource NeutralActionButtonStyle}"
                    Click="Skip_Click" />
            <TextBlock x:Name="PageIndicatorText" Grid.Column="1" Style="{StaticResource FieldHintStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="PrevButton" Content="上一步" Style="{StaticResource NeutralActionButtonStyle}"
                        Click="Prev_Click" />
                <Button x:Name="NextButton" Content="下一步" Style="{StaticResource PrimaryActionButtonStyle}"
                        Click="Next_Click" />
            </StackPanel>
        </Grid>

        <!-- 微软登录遮罩：盖住整屏引导，登录期间只看到「已打开浏览器」 -->
        <views:MicrosoftLoginOverlay x:Name="LoginOverlay" Grid.RowSpan="3" Visibility="Collapsed" />
    </Grid>
</UserControl>
