<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XO_Launcher.Models"
    xmlns:views="using:XO_Launcher.Views"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 设置行 / 顶栏页签的样式已提到 App.xaml（SettingRowStyle、SettingBlockStyle、
             SettingTitleStyle、SettingHintStyle、SettingSwitchStyle、SettingsTabButtonStyle），
             版本设置面板用同一套，这里只留本页要的类型转换器。 -->
        <models:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 分组顶栏（参考下载页的分类顶栏） ====================
             通栏一条浅底 + 1px 下边框，页签横排、窄窗口可横向滚动。
             顶栏固定在滚动区之外：一次只看一个分组，切换不该受滚动位置影响，也不该跟着内容滚走。 -->
        <Border x:Name="SettingsTabBar" Grid.Row="0" Background="{ThemeResource SidebarBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,10,20,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="NavRail" Orientation="Horizontal" Spacing="2">
                        <Button Style="{StaticResource SettingsTabButtonStyle}" Tag="AccountSection" Content="账号" Click="SettingsNav_Click" />
                        <Button Style="{StaticResource SettingsTabButtonStyle}" Tag="PersonalizationSection" Content="个性化" Click="SettingsNav_Click" />
                        <Button Style="{StaticResource SettingsTabButtonStyle}" Tag="LauncherSection" Content="启动器" Click="SettingsNav_Click" />
                        <Button Style="{StaticResource SettingsTabButtonStyle}" Tag="NotificationSection" Content="通知" Click="SettingsNav_Click" />
                        <Button Style="{StaticResource SettingsTabButtonStyle}" Tag="UpdateSection" Content="更新" Click="SettingsNav_Click" />
                        <Button Style="{StaticResource SettingsTabButtonStyle}" Tag="AiSection" Content="AI 助手" Click="SettingsNav_Click" />
                        <Button Style="{StaticResource SettingsTabButtonStyle}" Tag="CreditsSection" Content="开源致谢" Click="SettingsNav_Click" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Text="切换当前账号点右上角头像" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <!-- 不设 MaxWidth：ScrollViewer 用无限宽度量内容，MaxWidth 会让整栏收缩并偏移 -->
            <StackPanel x:Name="SettingsPanel" Spacing="14" Padding="24,18,24,24">

                <!-- ==================== 账号 ==================== -->
                <StackPanel x:Name="AccountSection" Spacing="12" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="账号" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingHintStyle}"
                                   Text="皮肤来源、微软登录、离线账号与删除都在这里。切换当前用谁更快：点窗口右上角头像。" />
                    </StackPanel>
                    <Border Style="{StaticResource PageCardStyle}">
                        <views:AccountSettingsBody />
                    </Border>
                </StackPanel>

                <!-- ==================== 个性化 ==================== -->
                <StackPanel x:Name="PersonalizationSection" Spacing="12" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="个性化" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingHintStyle}"
                                   Text="亮暗主题、字体与主题色会立刻应用到整个启动器。" />
                    </StackPanel>

                    <Border Style="{StaticResource PageCardStyle}" Padding="0">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="外观" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}" Text="跟随系统即按 Windows 的亮暗设置。" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="SystemThemeButton" Tag="system" Content="跟随系统" Click="ThemeCard_Click"
                                            Height="34" Padding="14,0" FontSize="12" BorderThickness="2" CornerRadius="6"
                                            Background="{ThemeResource NeutralButtonBrush}" Foreground="{ThemeResource NeutralButtonForegroundBrush}" />
                                    <Button x:Name="DarkThemeButton" Tag="dark" Content="暗色" Click="ThemeCard_Click"
                                            Height="34" Padding="14,0" FontSize="12" BorderThickness="2" CornerRadius="6"
                                            Background="{ThemeResource NeutralButtonBrush}" Foreground="{ThemeResource NeutralButtonForegroundBrush}" />
                                    <Button x:Name="LightThemeButton" Tag="light" Content="亮色" Click="ThemeCard_Click"
                                            Height="34" Padding="14,0" FontSize="12" BorderThickness="2" CornerRadius="6"
                                            Background="{ThemeResource NeutralButtonBrush}" Foreground="{ThemeResource NeutralButtonForegroundBrush}" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <StackPanel Style="{StaticResource SettingBlockStyle}">
                                <TextBlock Text="界面字体" Style="{StaticResource SettingTitleStyle}" />
                                <views:SelectBox x:Name="FontCombo" HorizontalAlignment="Left" MinWidth="340" MaxWidth="480"
                                                 SelectionChanged="FontCombo_SelectionChanged">
                                    <views:SelectBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontFamily="{Binding Family}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </views:SelectBox.ItemTemplate>
                                </views:SelectBox>
                                <TextBlock x:Name="FontPreviewText" Style="{StaticResource BodyTextStyle}"
                                           Text="预览：XO Launcher 启动器 版本 1.21" />
                            </StackPanel>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <StackPanel Style="{StaticResource SettingBlockStyle}">
                                <Grid>
                                    <TextBlock Text="主题色" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="CustomAccentButton" Content="自定义…" Click="CustomAccent_Click"
                                                Height="32" Padding="12,0" FontSize="12" BorderThickness="2" CornerRadius="6"
                                                Background="{ThemeResource NeutralButtonBrush}"
                                                Foreground="{ThemeResource NeutralButtonForegroundBrush}" />
                                        <TextBlock x:Name="AccentHexText" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="AccentSwatchHost" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="全景图背景" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="把当前选中版本的标题全景当背景：四张侧面拼成 360° 环带，滚动即绕场景转一圈。全景图保持清晰，卡片改成毛玻璃只糊它身后的画面；版本没有全景图时自动回到纯色背景。启动游戏时无论开关如何都会显示全景。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PanoramaToggle" Grid.Column="1" Style="{StaticResource SettingSwitchStyle}"
                                              Toggled="PanoramaToggle_Toggled" />
                            </Grid>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <StackPanel x:Name="PanoramaBlurPanel" Style="{StaticResource SettingBlockStyle}" Spacing="14">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="卡片毛玻璃浓度" Style="{StaticResource SettingTitleStyle}" FontSize="13" />
                                        <TextBlock x:Name="PanoramaBlurValueText" Text="0" FontSize="12"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="PanoramaBlurSlider" Minimum="0" Maximum="40" Value="0" StepFrequency="1"
                                            Width="360" HorizontalAlignment="Left" ValueChanged="PanoramaBlurSlider_ValueChanged" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="卡片底色用 WinUI 原生亚克力，这里调的是着色浓度：0 最透（全景看得最清），越大卡片越实。关闭全景时卡片始终是实心。" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="全景滚动速度" Style="{StaticResource SettingTitleStyle}" FontSize="13" />
                                        <TextBlock x:Name="PanoramaSpeedValueText" Text="5 档" FontSize="12"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="PanoramaSpeedSlider" Minimum="1" Maximum="10" Value="5" StepFrequency="1"
                                            Width="360" HorizontalAlignment="Left" ValueChanged="PanoramaSpeedSlider_ValueChanged" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="1 最慢、10 最快。背景是一条 360° 环带，转完一整圈为「一圈」。" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 启动器 ==================== -->
                <StackPanel x:Name="LauncherSection" Spacing="12" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="启动器" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingHintStyle}"
                                   Text="游戏目录、Java 与内存等运行条件，以及启动器自己的行为。" />
                    </StackPanel>

                    <Border Style="{StaticResource PageCardStyle}" Padding="0">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingBlockStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="游戏目录" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="可同时保存多个游戏文件夹，切换后版本列表、模组与 Java 运行时都会跟着当前目录走。" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <views:SelectBox x:Name="GameFolderCombo" HorizontalAlignment="Stretch"
                                                     DisplayMemberPath="Display" SelectionChanged="GameFolderCombo_SelectionChanged" />
                                    <Button Style="{StaticResource NeutralActionButtonStyle}" Grid.Column="1" Content="添加" Click="AddGameFolder_Click" />
                                    <Button Style="{StaticResource NeutralActionButtonStyle}" Grid.Column="2" Content="移除" Click="RemoveGameFolder_Click" />
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <views:TextInput x:Name="GameDirBox" LostFocus="GameDirBox_LostFocus" />
                                    <Button Style="{StaticResource NeutralActionButtonStyle}" Grid.Column="1" Content="浏览…" Click="BrowseGameDir_Click" />
                                </Grid>
                                <TextBlock x:Name="GameDirHint" Style="{StaticResource SettingHintStyle}"
                                           Text="可选择游戏安装的文件夹" />
                            </StackPanel>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <StackPanel Style="{StaticResource SettingBlockStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Java 虚拟机" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="自动搜索已安装的 Java。开启自动选择后，没有合适版本时会下载 Java。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoMatchToggle" Header="按游戏版本自动匹配 Java" OnContent="已开启" OffContent="已关闭"
                                              FontSize="12" HorizontalAlignment="Left" Toggled="AutoMatchToggle_Toggled" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <views:SelectBox x:Name="JavaCombo" HorizontalAlignment="Stretch"
                                                     PlaceholderText="未检测到 Java，可浏览或下载官方运行时"
                                                     SelectionChanged="JavaCombo_SelectionChanged" />
                                    <Button Style="{StaticResource NeutralActionButtonStyle}" Grid.Column="1" Content="浏览…" Click="BrowseJava_Click" />
                                    <Button Style="{StaticResource NeutralActionButtonStyle}" Grid.Column="2" Content="重新扫描" Click="DetectJava_Click" />
                                    <Button Style="{StaticResource PrimaryActionButtonStyle}" Grid.Column="3" x:Name="DownloadJavaButton" Content="下载官方 Java" Click="DownloadJava_Click" />
                                </Grid>
                                <TextBlock x:Name="JavaStatusText" Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <StackPanel Style="{StaticResource SettingBlockStyle}">
                                <Grid>
                                    <TextBlock Text="内存分配" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MemoryValueText" Text="4096 MB" FontSize="12"
                                               Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="MemorySlider" Minimum="1024" Maximum="16384" Value="4096" StepFrequency="1024"
                                        Width="360" HorizontalAlignment="Left" ValueChanged="MemorySlider_ValueChanged" />
                                <TextBlock Style="{StaticResource SettingHintStyle}" Text="建议分配 4 GB 内存。" />
                            </StackPanel>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <StackPanel Style="{StaticResource SettingBlockStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="资源下载目录" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="模组、光影与资源包将保存至此目录。下载完成后，请在版本设置中选择并安装。" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <views:TextInput x:Name="DownloadDirBox" LostFocus="DownloadDirBox_LostFocus" />
                                    <Button Style="{StaticResource NeutralActionButtonStyle}" Grid.Column="1" Content="浏览…" Click="BrowseDownloadDir_Click" />
                                    <Button Style="{StaticResource NeutralActionButtonStyle}" Grid.Column="2" Content="打开目录" Click="OpenDownloadFolder_Click" />
                                </Grid>
                                <TextBlock x:Name="DownloadDirHint" Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="下载源" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="下载游戏、Java、模组与整合包时使用的源。智能多源会同时走官方与镜像（Mojang 系走 BMCLAPI，Modrinth 系走 MCIMIRROR）；无法直连官方时选仅镜像源。" />
                                </StackPanel>
                                <views:SelectBox x:Name="MirrorCombo" Grid.Column="1" MinWidth="300" VerticalAlignment="Center"
                                                 SelectionChanged="MirrorCombo_SelectionChanged">
                                    <views:SelectBox.Items>
                                        <views:SelectBoxItem Content="智能多源（官方 + 镜像，推荐）" Tag="auto" />
                                        <views:SelectBoxItem Content="镜像优先（BMCLAPI / MCIM）" Tag="bmclapi" />
                                        <views:SelectBoxItem Content="仅镜像源" Tag="bmclapi_only" />
                                        <views:SelectBoxItem Content="仅官方源" Tag="official" />
                                    </views:SelectBox.Items>
                                </views:SelectBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCardStyle}" Padding="0">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="以中文显示模组名称" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="中文译名可能存在严重错误；没有中文译名的模组仍显示英文名。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="TranslateNamesToggle" Grid.Column="1" Style="{StaticResource SettingSwitchStyle}"
                                              Toggled="TranslateNamesToggle_Toggled" />
                            </Grid>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="启动游戏后关闭启动器" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="游戏窗口显示时启动器将自动退出，之后将无法进行故障分析。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CloseAfterLaunchToggle" Grid.Column="1" Style="{StaticResource SettingSwitchStyle}"
                                              Toggled="CloseAfterLaunchToggle_Toggled" />
                            </Grid>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="下载时自动跳转到消息页" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="有新的下载任务开始时，自动切到「消息」页查看进度。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoSwitchMessagesToggle" Grid.Column="1" Style="{StaticResource SettingSwitchStyle}"
                                              Toggled="AutoSwitchMessagesToggle_Toggled" />
                            </Grid>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="显示底部信息栏" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="底部信息栏显示 JAVA 版本、游戏目录与内存分配。关闭后底部只在启动游戏时显示进度。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowBottomBarToggle" Grid.Column="1" Style="{StaticResource SettingSwitchStyle}"
                                              Toggled="ShowBottomBarToggle_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCardStyle}" Padding="0">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingBlockStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="诊断与日志" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="游戏异常退出时会自动做故障分析。也可在此分析当前版本日志，或导出报告。" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Style="{StaticResource PrimaryActionButtonStyle}" x:Name="ExportLogButton" Content="导出错误日志" Click="ExportLog_Click" />
                                    <Button Style="{StaticResource NeutralActionButtonStyle}" Content="故障分析" Click="AnalyzeCrash_Click" />
                                    <Button Style="{StaticResource NeutralActionButtonStyle}" x:Name="ExportCrashButton" Content="导出崩溃日志" Click="ExportCrash_Click" />
                                    <Button Style="{StaticResource NeutralActionButtonStyle}" Content="打开日志文件夹" Click="OpenLogFolder_Click" />
                                </StackPanel>
                                <TextBlock x:Name="LogStatusText" Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 通知 ==================== -->
                <StackPanel x:Name="NotificationSection" Spacing="12" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="通知" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingHintStyle}"
                                   Text="通过 Windows 系统通知提醒，点击通知可跳转到对应页面。" />
                    </StackPanel>

                    <Border Style="{StaticResource PageCardStyle}" Padding="0">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="启用系统通知" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}" Text="总开关，关闭后下面几项都不再发送。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="NotificationsEnabledToggle" Grid.Column="1" Style="{StaticResource SettingSwitchStyle}"
                                              Toggled="NotificationsEnabledToggle_Toggled" />
                            </Grid>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="下载完成时通知我" Style="{StaticResource SettingTitleStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="NotifyDownloadToggle" Grid.Column="1" Style="{StaticResource SettingSwitchStyle}"
                                              Toggled="NotifyDownloadToggle_Toggled" />
                            </Grid>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="游戏崩溃时通知我" Style="{StaticResource SettingTitleStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="NotifyCrashToggle" Grid.Column="1" Style="{StaticResource SettingSwitchStyle}"
                                              Toggled="NotifyCrashToggle_Toggled" />
                            </Grid>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="AI 等待确认时通知我" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="AI 助手请求执行操作需要确认时发送通知，点击即可跳到 AI 页确认。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="NotifyAiToggle" Grid.Column="1" Style="{StaticResource SettingSwitchStyle}"
                                              Toggled="NotifyAiToggle_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 更新 ==================== -->
                <StackPanel x:Name="UpdateSection" Spacing="12" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="更新" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Name="CurrentVersionText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                   Text="当前版本 1.0.0" />
                    </StackPanel>

                    <Border Style="{StaticResource PageCardStyle}" Padding="0">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="启动时自动检查更新" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="只从官方站点 update.xolauncher.dpdns.org 检查，不支持自定义更新源。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoCheckUpdatesToggle" Grid.Column="1" Style="{StaticResource SettingSwitchStyle}"
                                              Toggled="AutoCheckUpdatesToggle_Toggled" />
                            </Grid>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <StackPanel Style="{StaticResource SettingBlockStyle}" Visibility="Collapsed">
                                <TextBlock Text="更新清单地址" Style="{StaticResource SettingTitleStyle}" FontSize="13" />
                                <views:TextInput x:Name="UpdateCheckUrlBox" IsReadOnly="True" IsEnabled="False"
                                                 Foreground="{ThemeResource TextSecondaryBrush}"
                                                 PlaceholderText="https://update.xolauncher.dpdns.org" />
                            </StackPanel>

                            <StackPanel Style="{StaticResource SettingBlockStyle}">
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingHintStyle}" Text="尚未检查更新。" />
                                <TextBlock x:Name="UpdateNotesText" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Visibility="Collapsed" />
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryActionButtonStyle}" x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" />
                                        <Button Style="{StaticResource PrimaryActionButtonStyle}" x:Name="DownloadUpdateButton" Content="下载更新" Click="DownloadUpdate_Click" Visibility="Collapsed" />
                                        <Button Style="{StaticResource PrimaryActionButtonStyle}" x:Name="ApplyUpdateButton" Content="安装并重启" Click="ApplyUpdate_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                    <HyperlinkButton x:Name="UpdatePageLink" Content="打开发布页" FontSize="12" Padding="8,0"
                                                     NavigateUri="https://update.xolauncher.dpdns.org/"
                                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== AI 助手 ==================== -->
                <StackPanel x:Name="AiSection" Spacing="12" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="AI 助手" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Name="AiProviderHintText" Style="{StaticResource SettingHintStyle}"
                                   Text="填写你自己的 API Key 后才能使用 AI 助手；启动器不内置任何密钥。" />
                    </StackPanel>

                    <Border Style="{StaticResource PageCardStyle}" Padding="0">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="模型" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="AiModelNoteText" Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>
                                <views:SelectBox Grid.Column="1" x:Name="AiModelSelect" MinWidth="300" VerticalAlignment="Center"
                                                 DisplayMemberPath="Label" SelectionChanged="AiModelSelect_SelectionChanged" />
                            </Grid>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <StackPanel Style="{StaticResource SettingBlockStyle}">
                                <TextBlock Text="API Key" Style="{StaticResource SettingTitleStyle}" />
                                <views:TextInput x:Name="AiKeyBox" PlaceholderText="粘贴你自己申请的 API Key"
                                                 LostFocus="AiKeyBox_LostFocus" />
                                <TextBlock Style="{StaticResource SettingHintStyle}"
                                           Text="密钥只写进本机设置文件（%LocalAppData%\XO_Launcher），不会上传，也不会出现在源码里。留空则 AI 页无法对话。" />
                                <TextBlock x:Name="AiKeyStateText" Style="{StaticResource SettingHintStyle}" Text="—" />
                            </StackPanel>

                            <Border Style="{StaticResource CardDividerStyle}" />

                            <StackPanel Style="{StaticResource SettingBlockStyle}">
                                <TextBlock Text="请求地址（BaseURL）" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock x:Name="AiEndpointText" Style="{StaticResource SettingHintStyle}"
                                           FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="12"
                                           IsTextSelectionEnabled="True" Text="—" />
                                <TextBlock Style="{StaticResource SettingHintStyle}"
                                           Text="端点随所选模型固定，只能从上面这几档里挑；实际请求地址在其后拼 /chat/completions。" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 开源致谢 ==================== -->
                <StackPanel x:Name="CreditsSection" Spacing="12" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="开源致谢" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingHintStyle}"
                                   Text="XO Launcher 在版本管理、实例隔离、模组生态与多账号等职责拆分上，参考了下列 GitHub 开源 Minecraft 启动器。向这些项目的作者与社区贡献者表示感谢。" />
                    </StackPanel>

                    <ItemsControl x:Name="CreditsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PageCardStyle}" Padding="0" Margin="0,0,0,10">
                                    <Grid ColumnSpacing="14" Padding="18,14,18,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40" Height="40" CornerRadius="8"
                                                Background="{Binding IconBadgeBrush}" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock Text="{Binding IconText}" FontSize="17" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding IconSource}" Stretch="Uniform" Margin="3" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SettingTitleStyle}" FontSize="13" />
                                                <TextBlock Text="{Binding RepoText}" FontSize="11" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SettingHintStyle}" />
                                            <HyperlinkButton Content="前往 GitHub 查看" NavigateUri="{Binding GitHubUri}" FontSize="11"
                                                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Padding="0"
                                                             HorizontalAlignment="Left" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource PageCardStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF4AA;" FontSize="14"
                                      Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource SettingHintStyle}"
                                       Text="同时感谢 Modrinth 与 Mojang 提供的开放 API —— 本启动器的模组资源与游戏版本清单均由它们提供。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
