<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.InstanceContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:XO_Launcher.Models">

    <UserControl.Resources>
        <models:SelectedAccentBorderConverter x:Key="SelectedAccentBorderConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2" MaxWidth="360" HorizontalAlignment="Left">
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock x:Name="CountText" Style="{StaticResource FieldHintStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="8">
                <Button x:Name="ExportModpackButton" Style="{StaticResource NeutralActionButtonStyle}" Content="导出整合包" Click="ExportModpack_Click" Visibility="Collapsed" />
                <Button Style="{StaticResource PrimaryActionButtonStyle}" Content="从下载库安装" Click="InstallFromLibrary_Click" />
                <Button Style="{StaticResource NeutralActionButtonStyle}" Content="前往资源库" Click="OpenLibrary_Click" />
                <Button Style="{StaticResource NeutralActionButtonStyle}" Content="打开目录" Click="OpenFolder_Click" />
                <Button Style="{StaticResource NeutralActionButtonStyle}" Content="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <ListView x:Name="ContentList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PageCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ShownName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <!-- DetailText 里含版本号（vX.Y.Z），由 jar 元数据读出 -->
                                <TextBlock Text="{Binding DetailText}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding IsEnabled}" OnContent="启用" OffContent="禁用"
                                          FontSize="11" MinWidth="0" VerticalAlignment="Center" Toggled="Enabled_Toggled" />
                            <Button Style="{StaticResource NeutralActionButtonStyle}" Grid.Column="2" Content="加入资源库" VerticalAlignment="Center" Click="AddToLibrary_Click" />
                            <Button Style="{StaticResource DangerActionButtonStyle}" Grid.Column="3" Content="移除" VerticalAlignment="Center" Click="Delete_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Style="{StaticResource FieldLabelStyle}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                   MaxWidth="420" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,8,0,0" />

        <Grid x:Name="LibraryPickerOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="{ThemeResource ContentDialogSmokeFill}">
            <Border Width="480" MaxHeight="440" Background="{ThemeResource CardAcrylicBrush}"
                    BorderThickness="0" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PickerTitle" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:Name="PickerHint" Grid.Row="2" Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" />
                    <ListView x:Name="PickerList" Grid.Row="4" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="PickerList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource ChipBackgroundBrush}" CornerRadius="8" Padding="12,10"
                                        BorderThickness="2"
                                        BorderBrush="{Binding IsSelected, Converter={StaticResource SelectedAccentBorderConverter}}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <!-- DetailText 里含版本号与体积 -->
                                        <TextBlock Text="{Binding DetailText}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="PickerEmpty" Grid.Row="4" Style="{StaticResource FieldLabelStyle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center" />
                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Style="{StaticResource NeutralActionButtonStyle}" Content="取消" Click="CancelPicker_Click" />
                        <Button Style="{StaticResource PrimaryActionButtonStyle}" x:Name="ConfirmPickerButton" Content="安装" Click="ConfirmPicker_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
