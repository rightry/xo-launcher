<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.PlayerAvatar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="AvatarFrame" Width="40" Height="40" CornerRadius="4"
            Background="{ThemeResource NeutralButtonBrush}" BorderBrush="{ThemeResource AccentDarkBrush}" BorderThickness="2">
        <Grid>
            <FontIcon FontFamily="{StaticResource IconFontFamily}" x:Name="FallbackIcon" Glyph="&#xF5C7;" FontSize="14" Foreground="{ThemeResource AccentBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image x:Name="HeadImage" Stretch="UniformToFill" Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
