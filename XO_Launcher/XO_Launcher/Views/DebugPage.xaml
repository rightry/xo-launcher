<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.DebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 调试页：默认不显示，靠「连续按下 20 个不同按键」解锁（见 MainWindow 的按键计数）。
         这里只放排查用得上的东西：环境、日志尾部、设置原文、元数据源连通性、缓存清理。 -->
    <Grid Padding="{StaticResource PagePaddingThickness}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="调试信息" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource FieldHintStyle}"
                               Text="本页是排障用的内部页面，普通使用不需要打开。这里的操作只影响本机缓存与视图，不会改游戏文件。" />
                </StackPanel>

                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="环境" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="EnvironmentText" Style="{StaticResource MetaTextStyle}"
                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" TextWrapping="Wrap" />
                        <Button Style="{StaticResource NeutralActionButtonStyle}" Content="刷新" Click="Refresh_Click"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="页面导航" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap"
                                   Text="列出每个页面的实例化与显示状态，点「进入」可绕过导航栏直接切页。页面是首次进入时才创建的，所以「未创建」是正常状态。" />
                        <StackPanel x:Name="PagesHost" Spacing="6" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="更新与引导页" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap"
                                   Text="走真实链路，不用为了看效果重装或改设置：检查更新会真的拉发布清单，有新版本才弹更新窗口；重看引导不会把「已看过」写回设置。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdateButton" Style="{StaticResource NeutralActionButtonStyle}"
                                    Content="检查并显示更新界面" Click="CheckUpdate_Click" />
                            <Button Style="{StaticResource NeutralActionButtonStyle}" Content="重看新手引导"
                                    Click="ShowOnboarding_Click" />
                            <Button Style="{StaticResource NeutralActionButtonStyle}" Content="只看更新说明"
                                    Click="ShowReleaseNotes_Click" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateStateText" Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="AI 连通性" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="AiTargetText" Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap" />
                        <Border Background="{ThemeResource RecessedBackgroundBrush}" CornerRadius="8" Padding="12,10">
                            <TextBlock x:Name="AiProbeText" FontSize="11" TextWrapping="Wrap"
                                       FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                       Foreground="{ThemeResource TextSecondaryBrush}" Text="尚未测试。" />
                        </Border>
                        <Button x:Name="AiProbeButton" Style="{StaticResource NeutralActionButtonStyle}"
                                Content="测试 AI 接口" Click="AiProbe_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="日志尾部" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="LogPathText" Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap" />
                        <Border Background="{ThemeResource RecessedBackgroundBrush}" CornerRadius="8" Padding="12,10">
                            <ScrollViewer MaxHeight="320" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="LogTailText" FontSize="11" TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource NeutralActionButtonStyle}" Content="重载尾部" Click="ReloadLog_Click" />
                            <Button Style="{StaticResource NeutralActionButtonStyle}" Content="打开日志目录" Click="OpenLogFolder_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="设置文件" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="SettingsPathText" Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap" />
                        <Border Background="{ThemeResource RecessedBackgroundBrush}" CornerRadius="8" Padding="12,10">
                            <ScrollViewer MaxHeight="260" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="SettingsText" FontSize="11" TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource NeutralActionButtonStyle}" Content="打开设置文件" Click="OpenSettings_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="元数据源连通性" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap"
                                   Text="逐个请求版本清单 / 加载器元数据，显示耗时与失败原因，用来判断「列表拉不出来」是网络还是解析问题。" />
                        <Border Background="{ThemeResource RecessedBackgroundBrush}" CornerRadius="8" Padding="12,10">
                            <TextBlock x:Name="ProbeText" FontSize="11" TextWrapping="Wrap"
                                       FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       Text="尚未测试。" />
                        </Border>
                        <Button x:Name="ProbeButton" Style="{StaticResource NeutralActionButtonStyle}"
                                Content="开始测试" Click="Probe_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="缓存" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap"
                                   Text="加载器版本列表按「加载器 + 游戏版本」缓存；全景环带缓存在 LocalAppData。清掉后下次会重新拉取 / 重新拼接。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource NeutralActionButtonStyle}" Content="清空加载器缓存" Click="ClearLoaderCache_Click" />
                            <Button Style="{StaticResource NeutralActionButtonStyle}" Content="打开全景缓存目录" Click="OpenPanoramaCache_Click" />
                        </StackPanel>
                        <TextBlock x:Name="CacheHintText" Style="{StaticResource FieldHintStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
