<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.SkinViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid MinWidth="280" MinHeight="360">
        <Border Background="{ThemeResource CardAltBackgroundBrush}" CornerRadius="10"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1">
            <Grid>
                <WebView2 x:Name="View" DefaultBackgroundColor="Transparent" />
                <Image x:Name="FallbackImage" Stretch="Uniform" Visibility="Collapsed" Margin="24" />
                <!-- 加载 / 错误态：转环 + 文案装进小卡片（App.xaml LoadingCardStyle）。
                     整张卡由代码的 SetStatus 统一开关：只有「正在加载…」才转环，
                     错误文案不转 —— 否则错误信息旁边挂个转环会以为还在加载。 -->
                <Border x:Name="StatusPanel" Style="{StaticResource LoadingCardStyle}" Padding="20,16">
                    <StackPanel Spacing="10">
                        <ProgressRing x:Name="StatusRing" IsActive="True" Width="26" Height="26"
                                      Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="正在加载 3D 预览…"
                                   FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="200" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,12">
            <Button x:Name="ClassicButton" Content="经典" Height="28" Padding="12,0" FontSize="11"
                    CornerRadius="4" BorderThickness="0" Click="Classic_Click"
                    Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentOnBrush}" />
            <Button x:Name="SlimButton" Content="纤细" Height="28" Padding="12,0" FontSize="11"
                    CornerRadius="4" BorderThickness="0" Click="Slim_Click"
                    Background="{ThemeResource NeutralButtonBrush}"
                    Foreground="{ThemeResource NeutralButtonForegroundBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
