<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.AccountSettingsBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:XO_Launcher.Views">

    <!-- 账号设置主体：当前账号、皮肤来源、账号列表（使用 / 删除）、微软登录与离线账号。
         宿主是设置页的「账号」分组；点头像弹出的窄浮层只做切换（见 AccountSwitcherBody）。 -->
    <StackPanel Spacing="14" MaxWidth="680">

        <Border Background="{ThemeResource CardAltBackgroundBrush}" CornerRadius="10" Padding="16">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:PlayerAvatar x:Name="CurrentAvatar" AvatarSize="52" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:Name="CurrentNameText" FontSize="17" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="CurrentTypeText" FontSize="12" Foreground="{ThemeResource AccentBrush}" />
                    <TextBlock x:Name="CurrentSkinSourceText" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 皮肤来源与皮肤绘制页共用同一个编辑器控件：规则（含 URL 白名单）只有一份 -->
        <views:SkinSourceEditor />

        <Border Style="{StaticResource CardDividerStyle}" />

        <StackPanel Spacing="8">
            <TextBlock Text="账号列表" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel x:Name="AccountListHost" Spacing="8" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MicrosoftLoginButton" HorizontalAlignment="Stretch" Height="38"
                        Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentOnBrush}"
                        BorderThickness="0" CornerRadius="6" FontSize="13" Click="MicrosoftLogin_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF58C;" FontSize="14"
                                  Foreground="{ThemeResource AccentOnBrush}" />
                        <TextBlock Text="正版登录" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Grid Grid.Column="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <views:TextInput x:Name="OfflineNameBox" PlaceholderText="离线玩家名" />
                    <Button Grid.Column="1" Style="{StaticResource NeutralActionButtonStyle}" Content="添加离线账户"
                            Click="AddOffline_Click" />
                </Grid>
            </Grid>
            <TextBlock x:Name="AccountStatusText" Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
