<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.BedrockDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,14,24,0">
            <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF15B;" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="返回版本列表" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <StackPanel HorizontalAlignment="Stretch" Padding="32,12,32,32" Spacing="16">

                <Border Style="{StaticResource PageCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="IconBorder" Width="72" Height="72" CornerRadius="12" Background="{ThemeResource AccentBrush}">
                            <TextBlock x:Name="IconText" Text="B" FontSize="22" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{ThemeResource AccentSoftBrush}" CornerRadius="4" Padding="8,3">
                                    <TextBlock x:Name="TypeText" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
                                </Border>
                                <TextBlock x:Name="MetaText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DescriptionText" Style="{StaticResource FieldHintStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="安装状态" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusHintText" Style="{StaticResource FieldHintStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="关于下载" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource FieldHintStyle}"
                                   Text="做法对齐 BedrockBoot：从版本库下载历史 APPX，解压到游戏目录并以开发人员模式注册。需要已购买 Minecraft for Windows 的微软账号，并开启 Windows 开发人员模式。多个版本可并排存放，启动时切换当前注册的包。专用服务器仍使用 Mojang 官方 ZIP。" />
                    </StackPanel>
                </Border>

                <Button x:Name="PrimaryButton" Height="52" HorizontalAlignment="Stretch" Background="{ThemeResource AccentBrush}"
                        Foreground="{ThemeResource AccentOnBrush}" BorderThickness="0" FontSize="16" FontWeight="Bold" CornerRadius="8"
                        Click="PrimaryButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" x:Name="PrimaryIcon" Glyph="&#xF60F;" FontSize="16" Foreground="{ThemeResource AccentOnBrush}" />
                        <TextBlock x:Name="PrimaryButtonText" Text="启动游戏" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="SecondaryButton" Height="44" HorizontalAlignment="Stretch"
                        Background="{ThemeResource NeutralButtonBrush}" Foreground="{ThemeResource NeutralButtonForegroundBrush}"
                        BorderThickness="0" FontSize="13" CornerRadius="8" Click="SecondaryButton_Click">
                    <TextBlock x:Name="SecondaryButtonText" Text="在 Microsoft Store 中查看" HorizontalAlignment="Center" />
                </Button>

                <Border x:Name="QueueTipBorder" Background="{ThemeResource AccentSoftBrush}" CornerRadius="8" Padding="12,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF02A3;" FontSize="13" Foreground="{ThemeResource AccentBrush}" />
                        <TextBlock x:Name="QueueTip" FontSize="12" Foreground="{ThemeResource AccentBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
