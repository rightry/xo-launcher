<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XO_Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:XO_Launcher.Views"
    xmlns:models="using:XO_Launcher.Models"
    mc:Ignorable="d"
    Title="XO Launcher">

    <!-- RootGrid 的 Padding 由代码在最大化时设成 8，把整个客户区从屏幕工作区边缘让开：
         边框式窗口最大化后，外圈那 8px 是标题栏绘制区，内容贴边会被裁掉。
         正常态由代码置为 0。参见 ApplyMaximizeInset。 -->
    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}" Padding="0">

        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <!-- WinUI 3 已知问题：App.xaml 级的主题字典覆盖无法穿透到框架控件模板
                         （开关、输入框聚焦边框等），需放在 Window 根元素资源上才生效。
                         参见 microsoft-ui-xaml#6394 与 StackOverflow 79742442。 -->
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#8FCC62" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#63A238" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#8FCC62" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#63A238" />
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#3A3A3A" />
                        <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#3A3A3A" />
                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8FCC62" />
                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#6BA83E" />
                        <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#4D7CBD4B" />
                        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#9BD06F" />
                        <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#B4DD95" />
                        <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#4D7CBD4B" />
                        <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#667CBD4B" />
                        <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#8FCC62" />
                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#6BA83E" />

                        <!-- WinUI 输入框/下拉框模板的底部 elevation 线：默认是上透明→底部白色
                             渐变的 ControlElevationBorderBrush，深色主题下表现为一条白线。 -->
                        <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#3A3A3A" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#8FCC62" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#63A238" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#8FCC62" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#63A238" />
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#D4D4D4" />
                        <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#D4D4D4" />
                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8FCC62" />
                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#6BA83E" />
                        <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#4D7CBD4B" />
                        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#5B8731" />
                        <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#6D9A3E" />
                        <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#82AC55" />
                        <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#4D7CBD4B" />
                        <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#5B8731" />
                        <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#7CBD4B" />
                        <SolidColorBrush x:Key="SystemControlHyperlinkTextBrush" Color="#5B8731" />
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#667CBD4B" />
                        <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#5B8731" />
                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#6D9A3E" />
                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#4A7229" />

                        <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#D4D4D4" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="NavPageButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource GhostButtonForeground}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <!-- 36 = 岛高 40 − 上下各 2 的内缩，让按钮正好嵌在导航岛里 -->
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            </Style>

            <!-- 导航选中下划线：过去贴着顶栏底边通体 48 宽，现在导航按钮进了「岛」，
                 通体宽会碾过岛的圆角，所以收窄居中、离底边留 5px。 -->
            <Style x:Key="NavIndicatorStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="2" />
                <Setter Property="RadiusX" Value="1" />
                <Setter Property="RadiusY" Value="1" />
                <Setter Property="Fill" Value="{ThemeResource AccentBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>

            <Style x:Key="TitleBarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource GhostButtonForeground}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            </Style>

            <!-- 顶栏的「岛」：灵动岛形状 —— 不是普通圆角矩形，而是两端完全半圆的胶囊
                 （CornerRadius = 高度 40 的一半 = 20）。
                 顶栏底色已与页面同色（AppBackgroundBrush），岛靠**比底色浅一档的实色**区分：
                 用 PanelBackgroundBrush（暗 #2D2D2D / 亮 #E8E8E8），正好比 AppBackground
                 （暗 #0E0E0E / 亮 #F3F3F3）浅一档，分界清晰又不刺眼。
                 不做浮雕：轻拟物（渐变 + 高光 + 暗影 + 投影）已按需求移除，
                 岛就是一块干净的单色胶囊，不留 BorderThickness。 -->
            <Style x:Key="TitleBarIslandStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PanelBackgroundBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <!-- 20 = 高 40 的一半，胶囊形的充要条件 -->
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="3,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 自绘窗口按钮（只有最小化与关闭）。
                 本启动器不支持最大化，所以这里没有最大化按钮——注意是「不存在」而不是「置灰」，
                 系统那三枚按钮已随 SetBorderAndTitleBar(hasBorder:true, hasTitleBar:false) 一并移除。 -->
            <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource ChromeTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 关闭键悬停变红（Windows 惯例）。模板必须整份重写：
                 VisualState 的 Setter 只能改「本模板内」元素的属性，
                 光靠 BasedOn 是改不到基类模板里那个 RootGrid 的。 -->
            <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="Content"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="#E5484D" />
                                                <Setter Target="Content.Foreground" Value="#FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="#C43A3F" />
                                                <Setter Target="Content.Foreground" Value="#FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <models:SafeFileImageConverter x:Key="SafeFileImageConverter" />
            <DataTemplate x:Key="InstalledVersionItemTemplate">
                <Grid Padding="4,10" ColumnSpacing="14" MinWidth="440">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="6" Background="Transparent">
                        <Image Source="{Binding IconPath, Converter={StaticResource SafeFileImageConverter}}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding LoaderLabel}" FontSize="11" Foreground="{ThemeResource AccentBrush}" />
                    </StackPanel>
                </Grid>
                </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 全景图背景层 ====================
             显示当前版本的标题全景图并缓慢横向滚动，图片本身保持清晰。
             毛玻璃由卡片自己的 WinUI 原生亚克力（CardAcrylicBrush）负责：
             它模糊自己身后的内容，浓度由设置里的滑杆调节。
             页面底色由 ThemeService.ApplyPanoramaStyle 切换为透明，露出这一层。 -->
        <Grid x:Name="PanoramaHost" Grid.Row="1" Visibility="Collapsed">
            <Canvas x:Name="PanoramaCanvas">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="PanoramaShift" />
                </Canvas.RenderTransform>
                <Image x:Name="PanoramaImageA" Stretch="UniformToFill" />
                <Image x:Name="PanoramaImageB" Stretch="UniformToFill" />
            </Canvas>
        </Grid>

        <!-- ==================== 顶部：四个独立「岛」 ====================
             图标岛 / 页面岛 / 用户岛 / 窗口按钮岛，块间留白把功能区切开。
             页面岛位于窗口正中，由它两侧的两块 * 拖动区等分剩余空间托住。
             · 窗口按钮岛里只有最小化与关闭：本启动器不支持最大化，系统那三枚按钮已随
               SetBorderAndTitleBar(hasBorder:true, hasTitleBar:false) 整体移除
               （AppWindowTitleBar 没有「单个按钮可见性」API，想让最大化键消失就只能整条去掉）。
             · 拖动只发生在 TitleBarDragLeft / TitleBarDrag 这两格 —— 它们刻意保持空元素：
               把按钮放进拖动区会抢输入。 -->
        <Grid x:Name="TitleBar" Background="{ThemeResource BarBackgroundBrush}">
            <!-- 页面岛居中：两侧各给一个 * 拖动区，等分剩余空间把页面岛推到窗口正中。
                 必须用「双 * 夹一个 Auto」而不是让页面岛跨列居中 —— 左右两块岛宽度不等
                 （图标岛含应用名、窗口岛含两枚按钮），单侧 * + HorizontalAlignment=Center
                 只会让它在「剩余空间」里居中，视觉上仍偏左。 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />  <!-- 0 图标岛 -->
                <ColumnDefinition Width="*" />     <!-- 1 拖动区（左） -->
                <ColumnDefinition Width="Auto" />  <!-- 2 页面岛（居中） -->
                <ColumnDefinition Width="*" />     <!-- 3 拖动区（右） -->
                <ColumnDefinition Width="Auto" />  <!-- 4 用户岛 -->
                <ColumnDefinition Width="Auto" />  <!-- 5 窗口按钮岛 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧拖动区：紧跟图标岛，元素本身透明无内容 -->
            <Grid x:Name="TitleBarDragLeft" Grid.Column="1" Background="Transparent" />

            <!-- 岛 1：软件图标 + 应用名 -->
            <Border Grid.Column="0" Style="{StaticResource TitleBarIslandStyle}"
                    Padding="11,0,14,0" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Image x:Name="AppIconImage" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="XO Launcher" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource ChromeTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 岛 2：页面导航（居中） -->
            <Border Grid.Column="2" Style="{StaticResource TitleBarIslandStyle}" Margin="8,0,8,0">
                <StackPanel x:Name="TitleBarNav" Orientation="Horizontal">
                            <Grid Width="48">
                                <Button x:Name="HomeNavButton" Style="{StaticResource NavPageButtonStyle}"
                                    ToolTipService.ToolTip="首页"
                                    Click="HomeNavButton_Click">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF487;" FontSize="18" />
                                </Button>
                                <Rectangle x:Name="HomeIndicator" Style="{StaticResource NavIndicatorStyle}" />
                            </Grid>
                            <Grid Width="48">
                                <Button x:Name="DownloadNavButton" Style="{StaticResource NavPageButtonStyle}"
                                    ToolTipService.ToolTip="下载" Click="DownloadNavButton_Click">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF150;" FontSize="18" />
                                </Button>
                                <Rectangle x:Name="DownloadIndicator" Style="{StaticResource NavIndicatorStyle}" Visibility="Collapsed" />
                            </Grid>
                            <Grid Width="48">
                                <Button x:Name="LibraryNavButton" Style="{StaticResource NavPageButtonStyle}"
                                    ToolTipService.ToolTip="资源库" Click="LibraryNavButton_Click">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE770;" FontSize="18" />
                                </Button>
                                <Rectangle x:Name="LibraryIndicator" Style="{StaticResource NavIndicatorStyle}" Visibility="Collapsed" />
                            </Grid>
                            <Grid Width="48">
                                <Button x:Name="OnlineNavButton" Style="{StaticResource NavPageButtonStyle}"
                                    ToolTipService.ToolTip="联机" Click="OnlineNavButton_Click">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF3D9;" FontSize="18" />
                                </Button>
                                <Rectangle x:Name="OnlineIndicator" Style="{StaticResource NavIndicatorStyle}" Visibility="Collapsed" />
                            </Grid>
                            <Grid Width="48">
                                <Button x:Name="AiNavButton" Style="{StaticResource NavPageButtonStyle}"
                                    ToolTipService.ToolTip="助手" Click="AiNavButton_Click">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE1CC;" FontSize="18" />
                                </Button>
                                <Rectangle x:Name="AiIndicator" Style="{StaticResource NavIndicatorStyle}" Visibility="Collapsed" />
                            </Grid>
                            <Grid Width="48">
                                <Button x:Name="SkinNavButton" Style="{StaticResource NavPageButtonStyle}"
                                    ToolTipService.ToolTip="皮肤" Click="SkinNavButton_Click">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF59C;" FontSize="18" />
                                </Button>
                                <Rectangle x:Name="SkinIndicator" Style="{StaticResource NavIndicatorStyle}" Visibility="Collapsed" />
                            </Grid>
                            <Grid Width="48">
                                <Button x:Name="SettingsNavButton" Style="{StaticResource NavPageButtonStyle}"
                                    ToolTipService.ToolTip="设置" Click="SettingsNavButton_Click">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF6B2;" FontSize="18" />
                                </Button>
                                <Rectangle x:Name="SettingsIndicator" Style="{StaticResource NavIndicatorStyle}" Visibility="Collapsed" />
                            </Grid>
                            <Grid Width="48">
                                <Button x:Name="MessagesNavButton" Style="{StaticResource NavPageButtonStyle}"
                                    ToolTipService.ToolTip="消息中心" Click="MessagesNavButton_Click">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF541;" FontSize="18" />
                                </Button>
                                <Rectangle x:Name="MessagesIndicator" Style="{StaticResource NavIndicatorStyle}" Visibility="Collapsed" />
                                <!-- 岛恢复为不透明实色后，徽标描边重新用 PanelBackgroundBrush「挖洞」，
                                     让红点与岛底之间有 1px 干净的分隔。 -->
                                <Border x:Name="MessagesBadge" Width="7" Height="7" CornerRadius="4" Background="#E5484D"
                                        BorderBrush="{ThemeResource PanelBackgroundBrush}" BorderThickness="1"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed" />
                    </Grid>
                            <!-- 调试入口：默认收起，累计按下 20 个不同按键后才出现（见 MainWindow 的按键计数） -->
                            <Grid x:Name="DebugNavHost" Width="48" Visibility="Collapsed">
                                <Button x:Name="DebugNavButton" Style="{StaticResource NavPageButtonStyle}"
                                    ToolTipService.ToolTip="调试信息" Click="DebugNavButton_Click">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xEE86;" FontSize="18" />
                                </Button>
                                <Rectangle x:Name="DebugIndicator" Style="{StaticResource NavIndicatorStyle}" Visibility="Collapsed" />
                            </Grid>
                </StackPanel>
            </Border>

            <!-- 拖动区（右）：页面岛与用户岛之间，保持空元素 -->
            <Grid x:Name="TitleBarDrag" Grid.Column="3" Background="Transparent" />

            <!-- 岛 3：当前用户 -->
            <Border x:Name="UserIsland" Grid.Column="4" Style="{StaticResource TitleBarIslandStyle}" Margin="0,0,8,0">
                <Button x:Name="CurrentUserButton" Style="{StaticResource TitleBarIconButtonStyle}"
                        Width="Auto" Height="34" Padding="8,0,12,0" CornerRadius="17"
                        ToolTipService.ToolTip="当前账号（点击管理账号与皮肤来源）" Click="CurrentUserButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <views:PlayerAvatar x:Name="TitleAvatar" AvatarSize="26" />
                        <TextBlock x:Name="AccountNameText" Text="Player" FontSize="13" Foreground="{ThemeResource ChromeTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Border>

            <!-- 岛 4：窗口控制。字形来自 FluentSystemIcons-Filled（不是 Segoe 那套 E921/E8BB）：
                 minimize = ic_fluent_subtract_20_filled        U+EBCA
                 maximize = ic_fluent_square_20_filled          U+EB7E（还原态时按代码换成 square_multiple U+EB9F）
                 close    = ic_fluent_dismiss_20_filled         U+F369 -->
            <Border Grid.Column="5" Style="{StaticResource TitleBarIslandStyle}" Padding="2,0" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                            ToolTipService.ToolTip="最小化" Click="MinimizeButton_Click">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xEBCA;" FontSize="13" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                            ToolTipService.ToolTip="最大化" Click="MaximizeButton_Click">
                        <FontIcon x:Name="MaximizeGlyph" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xEB7E;" FontSize="13" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButtonStyle}"
                            ToolTipService.ToolTip="关闭" Click="CloseButton_Click">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF369;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 页面内容 ==================== -->
        <Grid Grid.Row="1">
            <Grid x:Name="HomeView" Background="{ThemeResource AppBackgroundBrush}">
                <StackPanel x:Name="HomeContent" VerticalAlignment="Center" Spacing="34">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="HomeShiftTransform" X="0" />
                    </StackPanel.RenderTransform>

                    <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="6" Background="Transparent">
                            <Grid>
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" x:Name="HomeVersionGlyph" Glyph="&#xF2DD;" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="HomeVersionIcon" Stretch="UniformToFill" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="VersionText" Text="--" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock x:Name="VersionDescText" Text="未选择版本" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="SwitchVersionButton" Height="34" MinWidth="34" Padding="10,0" VerticalAlignment="Center" Background="{ThemeResource NeutralButtonBrush}"
                                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" CornerRadius="4"
                                Foreground="{ThemeResource GhostButtonForeground}"
                                ToolTipService.ToolTip="切换版本" Click="SwitchVersionButton_Click">
                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF2A3;" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                        <Button x:Name="InstanceSettingsButton" Height="50" Width="150"
                                Background="{ThemeResource NeutralButtonBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" CornerRadius="4"
                                Foreground="{ThemeResource GhostButtonForeground}" FontSize="18" Click="InstanceSettingsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF6B2;" FontSize="20" VerticalAlignment="Center" />
                                <TextBlock Text="版本设置" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="PlayButton" Height="50" Width="150" Background="{ThemeResource AccentBrush}"
                                BorderThickness="0" CornerRadius="4" Foreground="{ThemeResource AccentOnBrush}" FontSize="18"
                                Click="PlayButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF60F;" FontSize="20" VerticalAlignment="Center" />
                                <TextBlock x:Name="PlayButtonText" Text="启动游戏" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="LaunchStatusText" Text="" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid x:Name="DownloadHost" Visibility="Collapsed" />
            <Grid x:Name="LibraryHost" Visibility="Collapsed" />
            <Grid x:Name="OnlineHost" Visibility="Collapsed" />
            <Grid x:Name="AiHost" Visibility="Collapsed" />
            <Grid x:Name="SkinHost" Visibility="Collapsed" />
            <Grid x:Name="SettingsHost" Visibility="Collapsed" />
            <Grid x:Name="MessagesHost" Visibility="Collapsed" />
            <Grid x:Name="DebugHost" Visibility="Collapsed" />
            <Grid x:Name="InstanceSettingsHost" Visibility="Collapsed" />
        </Grid>

        <!-- ==================== 底部状态栏（启动时临时切换为进度条） ==================== -->
        <Grid x:Name="BottomBar" Grid.Row="2" Height="60" Background="{ThemeResource BarBackgroundBrush}">
            <Grid x:Name="BottomInfoGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0">
                    <Border Width="28" Height="28" CornerRadius="2" Background="{ThemeResource AccentDarkBrush}">
                        <TextBlock Text="J" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="JAVA 版本" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="JavaVersionText" Text="未配置" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ChromeTextBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="32" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="2" Background="#3B4A6B">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF432;" FontSize="13" Foreground="#C7D2E8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="游戏目录" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="GameDirectoryText" Text="未配置" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ChromeTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="340" VerticalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="3" Width="1" Height="32" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0">
                    <Border Width="28" Height="28" CornerRadius="2" Background="#7A4B3B">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF0F0;" FontSize="13" Foreground="#F0D9C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="内存分配" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="BottomMemoryText" Text="4096 MB" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ChromeTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid x:Name="BottomLaunchPanel" Visibility="Collapsed">
                <StackPanel Margin="28,0,28,0" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="BottomLaunchText" Text="" FontSize="11" Foreground="{ThemeResource ChromeTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="LaunchProgressBar" Height="4" IsIndeterminate="True"
                                 Foreground="{ThemeResource AccentBrush}" Background="{ThemeResource NeutralButtonBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ==================== 账号浮层 ====================
             锚在右上角头像岛正下方，不再用窗口居中的 AppDialog：「当前用谁 / 用哪张贴图」是即时操作，
             离头像越近越顺手。浮层与头像岛同一条右边缘（两者都距窗口右 8px），打开时头像岛从胶囊
             （半径 20）改成圆角矩形（半径 12）—— 整组读起来就是那块「放大了一圈」。
             遮罩盖住包括顶栏在内的整窗：点浮层外任意位置（含头像本身）即收起。 -->
        <Border x:Name="AccountPopoverScrim" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
                Background="#26000000" Tapped="AccountPopoverScrim_Tapped" />

        <Border x:Name="AccountPopover" Grid.Row="1" Width="330" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,8,0"
                Background="{ThemeResource CardAcrylicBrush}" BorderBrush="{ThemeResource AccentBrush}"
                BorderThickness="1" CornerRadius="12">
            <!-- 只做「显示 + 切换账号」，所以窄窄一条就够；设置项都在设置页的账号分组 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="16,12,12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="当前账号" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="点下面的名字即可切换" Style="{StaticResource FieldHintStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource NeutralActionIconButtonStyle}"
                            VerticalAlignment="Top" Click="AccountPopoverClose_Click"
                            ToolTipService.ToolTip="关闭 (Esc)">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF369;" FontSize="16" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" Height="1" VerticalAlignment="Top" Background="{ThemeResource DividerBrush}" />

                <ScrollViewer Grid.Row="1" Margin="0,1,0,0" Padding="16,12,16,14"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <!-- 每次打开才 new 一个主体：它会订阅静态的 AccountStore，
                         常驻就等于让隐藏的那份列表一直挂在事件上。
                         ContentControl 的内容默认左对齐，不写 Stretch 浮层右边会多出一条空白。 -->
                    <ContentControl x:Name="AccountPopoverHost" HorizontalContentAlignment="Stretch" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
