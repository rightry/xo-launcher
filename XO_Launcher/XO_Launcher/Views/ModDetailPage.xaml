<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.ModDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XO_Launcher.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <models:VersionTypeBrushConverter x:Key="VersionTypeBrushConverter" />
        <models:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </UserControl.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏：返回按钮 ==================== -->
        <Grid Padding="24,14,24,0">
            <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF15B;" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="返回资源列表" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" x:Name="ContentScrollViewer"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled" VerticalScrollMode="Enabled"
                      Visibility="Collapsed">
            <StackPanel x:Name="DetailBody" Padding="32,16,32,32" HorizontalAlignment="Stretch" Spacing="18">

                <!-- 顶部背景横幅（CoverBanner）已按需求移除：详情页不再显示任何背景图。
                     相关代码（LoadCover / ApplyCoverHeight）同步删除，图片也不再下载，不产生额外流量。 -->

                <!-- ==================== mod 头部 ==================== -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- mod 图标 -->
                    <Border x:Name="IconBorder" Width="72" Height="72" CornerRadius="10" Background="{ThemeResource PanelBackgroundBrush}" VerticalAlignment="Top">
                        <Grid>
                            <TextBlock x:Name="IconFallback" Text="?" FontSize="26" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="IconImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- 标题与元信息 -->
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                        <TextBlock x:Name="BadgeText" FontSize="12" Foreground="{ThemeResource AccentBrush}" />
                        <TextBlock x:Name="StatsText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />

                        <StackPanel Spacing="4" Margin="0,8,0,0">
                            <TextBlock Text="支持加载器" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock x:Name="LoaderItemsText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="4" Margin="0,2,0,0">
                            <TextBlock Text="游戏版本" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock x:Name="GameVersionItemsText" FontSize="12" Foreground="{ThemeResource AccentBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ==================== 介绍（默认折叠，不用 Expander 以免整页右偏） ==================== -->
                <Border Background="{ThemeResource CardAcrylicBrush}" CornerRadius="10"
                        BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1">
                    <StackPanel>
                        <Button x:Name="IntroToggle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="14,10" Click="IntroToggle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" x:Name="IntroChevron" Glyph="&#xF2B0;" FontSize="12"
                                          Foreground="{ThemeResource GhostButtonForeground}" VerticalAlignment="Center" />
                                <TextBlock x:Name="IntroTitleText" Text="模组介绍" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="IntroBody" Visibility="Collapsed" Spacing="8" Padding="14,0,14,12">
                            <TextBlock x:Name="DescriptionText" Style="{StaticResource FieldHintStyle}" />
                            <RichTextBlock x:Name="BodyMarkdown" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== 版本选择（按 Minecraft 版本分栏，仅在此页下载） ==================== -->
                <StackPanel x:Name="VersionSection" Spacing="10">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="VersionSectionTitle" Text="按游戏版本与加载器选择文件" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="VersionSectionHint" Text="文件将保存至资源下载目录。请在版本设置中选择并安装。进度请在「消息」中查看。" Style="{StaticResource FieldHintStyle}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ChannelReleaseButton" Content="正式版" Tag="release"
                                    Style="{StaticResource ChipButtonStyle}" Click="ChannelButton_Click" />
                            <Button x:Name="ChannelSnapshotButton" Content="快照版" Tag="snapshot"
                                    Style="{StaticResource ChipButtonStyle}" Click="ChannelButton_Click" />
                        </StackPanel>

                        <TextBlock x:Name="LibraryPathText" Style="{StaticResource FieldHintStyle}" />
                    </StackPanel>

                    <ItemsControl x:Name="VersionGroups">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardAcrylicBrush}" CornerRadius="10" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" Margin="0,0,0,10">
                                    <Expander IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF2DD;" FontSize="13" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding MinecraftVersion}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding VersionCountText}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LoaderSummary}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{Binding Loaders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{ThemeResource CardAltBackgroundBrush}" CornerRadius="8" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" Margin="0,6,0,4">
                                                        <Expander IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                            <Expander.Header>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Background="{ThemeResource AccentSoftBrush}" CornerRadius="4" Padding="8,2">
                                                                        <TextBlock Text="{Binding LoaderName}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding VersionCountText}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Expander.Header>

                                                            <ItemsControl ItemsSource="{Binding Versions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                                                                            <Grid ColumnSpacing="12">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>

                                                                                <StackPanel Spacing="4">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                        <TextBlock Text="{Binding VersionNumber}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                                                   Foreground="{Binding Converter={StaticResource VersionTypeBrushConverter}, ConverterParameter=title}" />
                                                                                        <Border Background="{ThemeResource DangerButtonBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                                                                                Visibility="{Binding IsAlpha, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                            <TextBlock Text="Alpha" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource DangerButtonForegroundBrush}" />
                                                                                        </Border>
                                                                                        <TextBlock Text="{Binding VersionTypeLabel}" FontSize="10" VerticalAlignment="Center"
                                                                                                   Foreground="{Binding VersionType, Converter={StaticResource VersionTypeBrushConverter}}"
                                                                                                   Visibility="{Binding IsAlpha, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                                                                        <TextBlock Text="{Binding FormattedDate}" FontSize="10" Foreground="{ThemeResource TextTertiaryBrush}" />
                                                                                        <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="{ThemeResource TextTertiaryBrush}" />
                                                                                        <TextBlock Text="{Binding FormattedDownloads}" FontSize="10" Foreground="{ThemeResource TextTertiaryBrush}" />
                                                                                        <Border Background="{ThemeResource AccentSoftBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                                                                                Visibility="{Binding HasRequiredDependencies, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                            <TextBlock Text="{Binding RequiredDependencyBadge}" FontSize="10" Foreground="{ThemeResource AccentBrush}" />
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                </StackPanel>

                                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                                    <Button Style="{StaticResource NeutralActionButtonStyle}" Content="下载" VerticalAlignment="Center" Tag="{Binding}" Click="DownloadVersionButton_Click" />
                                                                                    <Button Style="{StaticResource PrimaryActionButtonStyle}" Content="一键安装" VerticalAlignment="Center" FontWeight="SemiBold" Tag="{Binding}" Click="OneClickInstallButton_Click"
                                                                                            Visibility="{Binding IsModrinthSource, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Expander>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyVersionText" Text="暂无可用的下载版本" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" Visibility="Collapsed" />

                    <!-- 下载操作提示 -->
                    <Border x:Name="QueueTipBorder" Background="{ThemeResource AccentSoftBrush}" CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF02A3;" FontSize="13" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock x:Name="QueueTip" FontSize="12" Foreground="{ThemeResource AccentBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="InstallStepText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 加载中（小卡片，见 App.xaml LoadingCardStyle） ==================== -->
        <Border Grid.Row="1" x:Name="LoadingPanel" Style="{StaticResource LoadingCardStyle}">
            <StackPanel Spacing="12">
                <ProgressRing IsActive="True" Width="34" Height="34" Foreground="{ThemeResource AccentBrush}"
                              HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadingStatusText" Text="正在加载详情…" Foreground="{ThemeResource TextSecondaryBrush}"
                           FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
