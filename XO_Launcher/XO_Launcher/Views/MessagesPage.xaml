<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XO_Launcher.Models"
    xmlns:local="using:XO_Launcher.Views"
    mc:Ignorable="d">

    <UserControl.Resources>
        <models:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}" Padding="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="消息中心" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="错误和下载的进度将在此处显示" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource NeutralActionButtonStyle}" Content="导出错误日志" Click="ExportLogButton_Click" />
                <Button Style="{StaticResource NeutralActionButtonStyle}" Content="导出崩溃日志" Click="ExportCrashButton_Click" />
                <Button x:Name="CancelAllButton" Width="32" Height="32" Padding="0"
                        Background="{ThemeResource DangerButtonBrush}" Foreground="{ThemeResource DangerButtonForegroundBrush}" BorderThickness="0" CornerRadius="4"
                        Click="CancelAllButton_Click" Visibility="Collapsed"
                        ToolTipService.ToolTip="全部终止">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF742;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PageCardStyle}" x:Name="GameStatusCard" Visibility="Collapsed" Margin="0,0,0,16">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="38" Height="38" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}" VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE697;" FontSize="16" Foreground="{ThemeResource AccentSoftForegroundBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="GameStatusTitle" Text="游戏运行中" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock x:Name="GameStatusDetail" Text="" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="CloseGameButton" Content="关闭游戏" Height="28" Padding="14,0"
                                Background="{ThemeResource DangerButtonBrush}" Foreground="{ThemeResource DangerButtonForegroundBrush}" BorderThickness="0" CornerRadius="4" FontSize="11"
                                Click="CloseGameButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource PageCardStyle}" x:Name="CrashCard" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,16" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="故障分析" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Content="AI 深度分析" Height="28" Padding="12,0" HorizontalAlignment="Right"
                                Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentOnBrush}"
                                BorderThickness="0" CornerRadius="4" FontSize="11" Click="AiCrashButton_Click" />
                    </Grid>
                    <local:CrashAnalysisPanel x:Name="SessionCrashPanel" Grid.Row="2" Height="260" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
            <!-- 空状态 -->
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF541;" FontSize="30" Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="暂无消息" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Center" />
                </StackPanel>

            <!-- 下载任务列表 -->
            <ListView x:Name="TasksList" SelectionMode="None" IsItemClickEnabled="False" Margin="0,0,0,8">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PageCardStyle}" Margin="0,0,0,10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 状态图标 -->
                                <Border Width="38" Height="38" CornerRadius="8" Background="{ThemeResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF150;" FontSize="15" Foreground="{ThemeResource AccentSoftForegroundBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                            <TextBlock Text="{Binding Status}" FontSize="11"
                                                       Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"
                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                 Foreground="{ThemeResource AccentBrush}" Background="{ThemeResource NeutralButtonBrush}" />

                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="{ThemeResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                            <TextBlock Text="{Binding TransferText}" FontSize="10" Foreground="{ThemeResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                    </Grid>

                                    <StackPanel Visibility="{Binding ShowSteps, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="4" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding StepTitle}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding StepLog}" FontSize="11"
                                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Width="28" Height="28" Padding="0"
                                            Background="{ThemeResource DangerButtonBrush}" Foreground="{ThemeResource DangerButtonForegroundBrush}" BorderThickness="0" CornerRadius="4"
                                            Tag="{Binding}" Click="CancelTask_Click"
                                            ToolTipService.ToolTip="终止"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF742;" FontSize="12" />
                                    </Button>
                                    <Button Width="28" Height="28" Padding="0"
                                            Background="{ThemeResource NeutralButtonBrush}" Foreground="{ThemeResource NeutralButtonForegroundBrush}" BorderThickness="0" CornerRadius="4"
                                            Tag="{Binding}" Click="DeleteTask_Click" ToolTipService.ToolTip="删除这条消息"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF34C;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
