<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.SkinSourceEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:XO_Launcher.Views">

    <!-- 「游戏里实际用哪张贴图」编辑器：下拉决定来源，选本地/URL 时才露出配套那一行。
         抽成控件是因为它有两个宿主：账号浮层（全局）和皮肤绘制页（画完就地切换预览来源）。
         域名白名单这类校验只在这里有一份，两处不会各写一套规则。 -->
    <StackPanel Spacing="8">
        <TextBlock Text="皮肤来源" Style="{StaticResource SectionTitleStyle}" />
        <TextBlock Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap"
                   Text="决定游戏里实际用哪张贴图，只作用于当前账号。" />
        <views:SelectBox x:Name="SkinSourceCombo" HorizontalAlignment="Stretch"
                         SelectionChanged="SkinSourceCombo_SelectionChanged">
            <views:SelectBox.Items>
                <views:SelectBoxItem Content="默认（Steve / Alex）" Tag="default" />
                <views:SelectBoxItem Content="Mojang 官方（仅微软账号）" Tag="mojang" />
                <views:SelectBoxItem Content="本地 PNG（自制皮肤）" Tag="local" />
                <views:SelectBoxItem Content="远端 URL（自托管 / LittleSkin 等）" Tag="url" />
            </views:SelectBox.Items>
        </views:SelectBox>

        <Grid ColumnSpacing="8" x:Name="LocalSkinRow" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LocalSkinPathText" Style="{StaticResource MetaTextStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="（尚未选择本地皮肤）" />
            <Button Style="{StaticResource NeutralActionIconButtonStyle}" Grid.Column="1"
                    Click="PickLocalSkin_Click" ToolTipService.ToolTip="选择本地 PNG 皮肤…">
                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF432;" FontSize="16" />
            </Button>
        </Grid>

        <StackPanel Spacing="6" x:Name="SkinUrlRow" Visibility="Collapsed">
            <TextBlock Style="{StaticResource FieldHintStyle}"
                       Text="远端 URL（HTTPS，仅 mojang.com / minecraft.net / crafatar.com / littleskin.cn）" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <views:TextInput x:Name="SkinUrlBox" PlaceholderText="https://littleskin.cn/avatar/.../skin.png" />
                <Button Style="{StaticResource NeutralActionButtonStyle}" Grid.Column="1"
                        Content="应用" Click="ApplySkinUrl_Click" />
            </Grid>
        </StackPanel>

        <TextBlock x:Name="SkinStatusText" Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
