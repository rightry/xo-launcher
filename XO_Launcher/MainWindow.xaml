<Window
    x:Class="XO_Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}" RequestedTheme="Dark">

        <Grid.Resources>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="IsPointerOver" Value="True">
                        <Setter Property="Background" Value="#E81123" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#C50F1F" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部标题栏 ==================== -->
        <Grid x:Name="TitleBar" Background="{ThemeResource AppBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：返回按钮 + 应用 Logo -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                <Button x:Name="BackButton" Style="{StaticResource NavButtonStyle}" ToolTipService.ToolTip="返回">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0,0,0">
                    <!-- Creeper 头像 -->
                    <Border Width="24" Height="24" CornerRadius="6" Background="#3FB950">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,3,0,0">
                                <Border Width="5" Height="5" Background="#0D1117" />
                                <Border Width="5" Height="5" Background="#0D1117" />
                            </StackPanel>
                            <Border Grid.Row="1" Width="5" Height="5" Background="#0D1117" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </Grid>
                    </Border>
                    <TextBlock Text="XO Launcher" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- 中部：页面名称 -->
            <TextBlock Grid.Column="1" Text="启动器主页" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- 右侧：账号 + 窗口控制 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0">
                <Button x:Name="AccountButton" Style="{StaticResource NavButtonStyle}" Width="32" Height="32" CornerRadius="16"
                        ToolTipService.ToolTip="账号">
                    <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" />
                </Button>
                <Rectangle Width="1" Height="20" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Center" />
                <Button x:Name="MinButton" Style="{StaticResource NavButtonStyle}" ToolTipService.ToolTip="最小化">
                    <FontIcon Glyph="&#xE921;" FontSize="13" />
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource NavButtonStyle}" ToolTipService.ToolTip="最大化">
                    <FontIcon Glyph="&#xE922;" FontSize="13" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" ToolTipService.ToolTip="关闭">
                    <FontIcon Glyph="&#xE8BB;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 主内容区 ==================== -->
        <Grid Grid.Row="1" Margin="28,20,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="356" />
            </Grid.ColumnDefinitions>

            <!-- ---------- 左侧：资讯 + 推荐模组 ---------- -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel Spacing="24">

                    <!-- 资讯横幅（Hero） -->
                    <Border CornerRadius="16" Padding="28" Height="210">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1E2A38" Offset="0" />
                                <GradientStop Color="#1F3D2E" Offset="0.55" />
                                <GradientStop Color="#214B33" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="#3FB950" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="最新资讯" Foreground="#0D1117" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="更新 · 2026年8月20日" Foreground="#9AB5A0" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="1.21.5 全新版本现已发布" FontSize="26" FontWeight="Bold" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="「挚爱更新」正式上线，带来全新樱花林地生物群系与更多趣味玩法，立即体验！"
                                           FontSize="13" Foreground="#B9C7B8" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- 轮播指示点（静态） -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#3E4C5C" />
                                <Border Width="22" Height="8" CornerRadius="4" Background="#3FB950" />
                                <Border Width="8" Height="8" CornerRadius="4" Background="#3E4C5C" />
                                <Border Width="8" Height="8" CornerRadius="4" Background="#3E4C5C" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 推荐模组 -->
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="推荐模组" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="查看更多 >" FontSize="12" Foreground="#58A6FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Sodium -->
                            <Border Background="#171F2E" CornerRadius="12" Padding="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#1F6FEB">
                                        <TextBlock Text="S" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Sodium" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock Text="渲染优化" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock Text="⬇ 1.2M" FontSize="11" Foreground="#58A6FF" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- JEI -->
                            <Border Grid.Column="1" Background="#171F2E" CornerRadius="12" Padding="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#2EA043">
                                        <TextBlock Text="J" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="JEI" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock Text="物品管理" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock Text="⬇ 980K" FontSize="11" Foreground="#58A6FF" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- OptiFine -->
                            <Border Grid.Column="2" Background="#171F2E" CornerRadius="12" Padding="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#D29922">
                                        <TextBlock Text="O" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="OptiFine" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock Text="画质优化" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock Text="⬇ 2.4M" FontSize="11" Foreground="#58A6FF" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Iris -->
                            <Border Grid.Column="3" Background="#171F2E" CornerRadius="12" Padding="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#8250DF">
                                        <TextBlock Text="I" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Iris" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock Text="光影支持" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock Text="⬇ 1.8M" FontSize="11" Foreground="#58A6FF" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 最新资讯列表 -->
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="最新资讯" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="查看更多 >" FontSize="12" Foreground="#58A6FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Background="{ThemeResource AppBarBackgroundBrush}" CornerRadius="12" Padding="20,6">
                            <StackPanel>

                                <Grid Margin="0,12,0,12" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="08/18" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="快照 26W33A 发布：全新伙伴系统内容前瞻" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#1F6FEB" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="预览" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" />

                                <Grid Margin="0,12,0,12" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="08/12" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="1.21.5「挚爱更新」正式版更新内容一览" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#2EA043" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" />

                                <Grid Margin="0,12,0,12" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="08/05" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="服务器租赁夏季特惠活动正式开启" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#D29922" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="活动" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" />

                                <Grid Margin="0,12,0,4" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="07/28" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="XO Launcher 2.4 版本更新日志" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#6E7681" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="公告" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ---------- 右侧：启动卡片 ---------- -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <Border Background="{ThemeResource AppBarBackgroundBrush}" CornerRadius="16" Padding="24">
                    <StackPanel Spacing="18">

                        <TextBlock Text="启动游戏" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />

                        <!-- 游戏版本 -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="游戏版本" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <ComboBoxItem Content="1.21.5 正式版" />
                                <ComboBoxItem Content="1.20.4 正式版" />
                                <ComboBoxItem Content="1.8.9 正式版" />
                                <ComboBoxItem Content="1.21.4 快照版" />
                            </ComboBox>
                        </StackPanel>

                        <!-- 游戏目录 -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="游戏目录" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="C:\Users\rmb12\AppData\Roaming\.minecraft" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="浏览" />
                            </Grid>
                        </StackPanel>

                        <!-- 启动按钮 -->
                        <Button x:Name="LaunchButton" HorizontalAlignment="Stretch" Height="56" CornerRadius="10"
                                Background="#3FB950" Foreground="#0D1117" FontSize="17" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="#0D1117" />
                                <TextBlock Text="开始游戏" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" />

                        <!-- 登录账号 -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="登录账号" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Text="管理账号 >" FontSize="12" Foreground="#58A6FF" HorizontalAlignment="Right" />
                            </Grid>
                            <ComboBox HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" SelectedIndex="0">
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#1F6FEB" VerticalAlignment="Center">
                                            <TextBlock Text="张" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Steve_Zhang（离线模式）" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Content="使用微软账号登录..." />
                            </ComboBox>
                        </StackPanel>

                        <!-- 内存分配 -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="内存分配" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Text="4096 MB" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="1024" Maximum="16384" Value="4096" StepFrequency="1024" />
                            <TextBlock Text="建议分配 4GB，总内存 16GB" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- 登录方式标签 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#1F6FEB" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="微软" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#6E7681" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="离线" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#6E7681" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="外置" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
